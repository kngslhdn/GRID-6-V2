//| TIMER                                                            |
//+------------------------------------------------------------------+
void OnTimer()
{
   UpdateNewsStatus();
}

//+------------------------------------------------------------------+
//| MAIN TICK                                                        |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return;

   if(IsTerminated)
   {
      DeleteRecoveryPending();
      CloseAllExposure();
      UpdateStatus();

      double haltedBalance=AccountInfoDouble(ACCOUNT_BALANCE);
      double haltedEquity=AccountInfoDouble(ACCOUNT_EQUITY);

      double haltedDD=
         (haltedEquity<haltedBalance && haltedBalance>0)?
         (haltedBalance-haltedEquity)/haltedBalance*100.0:
         0.0;

      DisplayDashboard(haltedDD);
      return;
   }

   ResetDailyTargetIfNewDay();

   if(IsNewsEngineAllowed())
      UpdateNewsStatus();

   UpdateStatus();

   double equity=AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity>HighWaterMark)
      HighWaterMark=equity;

   double dd=
      (equity<HighWaterMark && HighWaterMark>0)?
      (HighWaterMark-equity)/HighWaterMark*100.0:
      0.0;

   if(dd>=MaxEquityLossPercent)
   {
      PrintFormat("V21 RISK STOP | DD=%.2f%% | MAX=%.2f%%",dd,MaxEquityLossPercent);
      DeleteRecoveryPending();
      CloseBasket();
      IsTerminated=true;
      DisplayDashboard(dd);
      return;
   }

   if(CheckDailyTarget())
   {
      DisplayDashboard(dd);
      return;
   }

   ManageBasketExit();
   UpdateStatus();

   if(CheckDailyTarget())
   {
      DisplayDashboard(dd);
      return;
   }

   if(UseTradingHour && !IsTradingHour())
   {
      CloseAllExposure();
      DisplayDashboard(dd);
      return;
   }

   if(IsNewsEngineAllowed() && NewsCloseWindow)
   {
      DeleteRecoveryPending();
      CloseAllExposure();
      DisplayDashboard(dd);
      return;
   }

   if(RecoveryActive)
   {
      if(ManageRecoveryBasketExit())
      {
         UpdateStatus();
         DisplayDashboard(dd);
         return;
      }

      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage2();

      DisplayDashboard(dd);
      return;
   }

   if(BuyOrders>=MaxOrders && SellOrders==0)
   {
      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage1(POSITION_TYPE_BUY);

      DisplayDashboard(dd);
      return;
   }

   if(SellOrders>=MaxOrders && BuyOrders==0)
   {
      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage1(POSITION_TYPE_SELL);

      DisplayDashboard(dd);
      return;
   }

   if(!IsNewsBlockingPrimary())
      ManagePrimaryGrid();

   DisplayDashboard(dd);
}
