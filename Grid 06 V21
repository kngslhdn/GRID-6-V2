bool IsOurPosition(ulong ticket)
{
   if(ticket==0 || !PositionSelectByTicket(ticket))
      return false;

   return PositionGetInteger(POSITION_MAGIC)==OrdersID &&
          PositionGetString(POSITION_SYMBOL)==SymbolTrade;
}

bool IsOurOrder(ulong ticket)
{
   if(ticket==0 || !OrderSelect(ticket))
      return false;

   return OrderGetInteger(ORDER_MAGIC)==OrdersID &&
          OrderGetString(ORDER_SYMBOL)==SymbolTrade;
}

bool TradeOK()
{
   uint r=trade.ResultRetcode();

   return r==TRADE_RETCODE_DONE ||
          r==TRADE_RETCODE_DONE_PARTIAL ||
          r==TRADE_RETCODE_PLACED;
}

//+------------------------------------------------------------------+
//| VOLUME / EXECUTION SAFETY                                        |
//+------------------------------------------------------------------+
double NormalizeVolume(double v)
{
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);

   if(mn<=0) mn=0.01;
   if(st<=0) st=0.01;
   if(mx<=0) mx=v;

   v=MathMax(mn,MathMin(mx,v));
   v=MathRound(v/st)*st;
   v=MathMax(mn,MathMin(mx,v));

   int digits=(st<0.01)?3:2;
   if(st<0.001) digits=4;

   return NormalizeDouble(v,digits);
}

bool CanOpenNewPosition(double volume)
{
   if(volume<=0)
      return false;

   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);
   double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);

   if(point<=0 || bid<=0 || ask<=0 || ask<bid)
      return false;

   if(MaxSpreadPoints>0 && (ask-bid)/point>MaxSpreadPoints)
   {
      PrintFormat("V21 ENTRY BLOCKED | spread %.0f > max %.0f points",
                  (ask-bid)/point,MaxSpreadPoints);
      return false;
   }

   double totalLots=BuyLots+SellLots+RecoveryLots;

   if(MaxTotalLots>0 &&
      totalLots+volume>MaxTotalLots+0.00000001)
   {
      PrintFormat("V21 ENTRY BLOCKED | total lots %.2f + %.2f > max %.2f",
                  totalLots,volume,MaxTotalLots);
      return false;
   }

   double equity=AccountInfoDouble(ACCOUNT_EQUITY);
   double freeMargin=AccountInfoDouble(ACCOUNT_FREEMARGIN);

   if(equity<=0 || freeMargin<0)
      return false;

   double freeMarginPercent=freeMargin/equity*100.0;

   if(MinimumFreeMarginPercent>0 &&
      freeMarginPercent<MinimumFreeMarginPercent)
   {
      PrintFormat("V21 ENTRY BLOCKED | free margin %.1f%% < min %.1f%%",
                  freeMarginPercent,MinimumFreeMarginPercent);
      return false;
   }

   if(EntryCooldownSeconds>0 &&
      LastEntryTime>0 &&
      TimeCurrent()-LastEntryTime<EntryCooldownSeconds)
      return false;

   return true;
}

