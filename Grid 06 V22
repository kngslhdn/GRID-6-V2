//+------------------------------------------------------------------+
//| GRID 06.V22 - V21 FINDINGS + CONTROLLED RECOVERY EDITION     |
//| V21 benchmark findings applied: DD, holding time, session risk |
//| XAUUSD / MT5 / Hedging Account                                   |
//+------------------------------------------------------------------+
#property strict
#property version "22.10"

#include <Trade/Trade.mqh>
CTrade trade;

//================ TIMEZONE =================//
input double ServerUTCOffsetHours   = 0.0;
input double StrategyUTCOffsetHours = 7.0;   // WIB = UTC+7

//================ ENTRY TYPE =================//
enum Type {Open_Buy_And_Sell,Open__Only_Buy,Open__Only_Sell};

//================ BASKET =================//
input double TargetProfitUSD         = 10.0;
input bool   UseTrailingProfit       = true;
input double TrailingStartUSD        = 5.0;
input double TrailingStopUSD         = 3.0;

//================ DAILY TARGET =================//
input bool   EnableDailyTarget       = true;
input double DailyTargetProfitUSD    = 100.0;

//================ RISK =================//
input double MaxEquityLossPercent    = 30.0;

//================ PRIMARY =================//
input int    MAPeriod                = 200;
input int    RSIPeriod               = 14;
input int    RSIUpper                = 61;
input int    RSILower                = 41;
input Type   TypeOrdersPlace         = Open_Buy_And_Sell;

// Loss grid
input double PointsForFirstGap       = 3000.0;
input double GapMultiplier           = 1.25;

// Profit-direction expansion
input bool   EnableProfitDirection   = true;
input double PointsForProfitGap      = 1000.0;

input double ManualLotSize           = 0.01;
input int    MaxOrders               = 3;

//================ EXECUTION SAFETY =================//
input double MaxTotalLots             = 1.0;
input double MinimumFreeMarginPercent = 70.0;
input double MaxSpreadPoints          = 500.0;
input int    EntryCooldownSeconds     = 30;

//================ TWO-STAGE CONTROLLED RECOVERY =================//
// V12 concept retained, but V20 safety philosophy applied.
// Recovery multipliers are deliberately capped.
input bool   EnableRecovery             = true;

// Stage 1
input double Recovery1Multiplier        = 2.0;
input double Recovery1GapPoints         = 2000.0;
input double Recovery1MaxLot            = 0.50;

// Stage 2
input bool   AllowRecoveryStage2        = false;
input double Recovery2Multiplier        = 3.0;
input double Recovery2GapPoints         = 6250.0;
input double Recovery2MaxLot            = 0.75;

// Hard caps
input double RecoveryMaxHedgeMultiplier = 2.0;

// Recovery behavior
input bool   RecoveryOnlyWhenMinus      = true;
input int    MaxRecoveryStages          = 1;
input double RecoveryExitProfitUSD      = 2.0;

// $2,500 V22.10 profile derived from V21 Test 2 findings: lower DD tolerance,
// shorter/smaller recovery exposure, and session blocking to reduce long holds.
input double DefensiveEquityLossPercent = 15.0;

// Recovery stage loss caps. These protect against a single recovery
// position becoming the dominant source of account drawdown.
input double Recovery1MaxLossUSD          = 150.0;
input double Recovery2MaxLossUSD          = 300.0;

//================ HOURS =================//
input bool   UseTradingHour          = true;
input int    StartHour               = 7;