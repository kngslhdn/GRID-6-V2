bool DailyTargetReached=false;

int GetServerDayKey(){ MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt); return dt.year*1000+dt.day_of_year; }
void ResetDailyTargetIfNewDay(){
   MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt);
   if(DailyTargetYear==dt.year && DailyTargetDayOfYear==dt.day_of_year) return;
   DailyTargetYear=dt.year; DailyTargetDayOfYear=dt.day_of_year;
   DailyStartBalance=AccountInfoDouble(ACCOUNT_BALANCE); DailyTargetReached=false;
}
double GetDailyRealizedProfit(){
   MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt); dt.hour=0; dt.min=0; dt.sec=0;
   datetime dayStart=StructToTime(dt),now=GetStrategyTime();
   if(!SelectStrategyHistory(dayStart,now)) return 0.0;
   double result=0.0; int deals=HistoryDealsTotal();
   for(int i=0;i<deals;i++){
      ulong ticket=HistoryDealGetTicket(i); if(ticket==0) continue;
      if((long)HistoryDealGetInteger(ticket,DEAL_MAGIC)!=OrdersID) continue;
      if(HistoryDealGetString(ticket,DEAL_SYMBOL)!=SymbolTrade) continue;
      long entry=HistoryDealGetInteger(ticket,DEAL_ENTRY);
      if(entry!=DEAL_ENTRY_OUT && entry!=DEAL_ENTRY_OUT_BY && entry!=DEAL_ENTRY_INOUT) continue;
      result+=HistoryDealGetDouble(ticket,DEAL_PROFIT)+HistoryDealGetDouble(ticket,DEAL_SWAP)+HistoryDealGetDouble(ticket,DEAL_COMMISSION)+HistoryDealGetDouble(ticket,DEAL_FEE);
   }
   return result;
}
double GetDailyProfit(){ return EnableDailyTarget ? GetDailyRealizedProfit()+BasketProfitValue : 0.0; }
void LockDailyTarget(){
   if(DailyTargetReached) return;
   DailyTargetReached=true; DeleteRecoveryPending(); CloseAllExposure(); UpdateStatus();
}
bool CheckDailyTarget(){
   if(!EnableDailyTarget || DailyTargetProfitUSD<=0.0) return false;
   ResetDailyTargetIfNewDay(); if(DailyTargetReached) return true;
   if(GetDailyProfit()>=DailyTargetProfitUSD){ LockDailyTarget(); return true; }
   return false;
}
bool IsTradingHour(){
   if(!UseTradingHour) return true; MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt);
   if(StartHour<EndHour) return dt.hour>=StartHour && dt.hour<EndHour;
   return dt.hour>=StartHour || dt.hour<EndHour;
}
bool IsOurPosition(ulong ticket){ return ticket!=0 && PositionSelectByTicket(ticket) && PositionGetInteger(POSITION_MAGIC)==OrdersID && PositionGetString(POSITION_SYMBOL)==SymbolTrade; }
bool IsOurOrder(ulong ticket){ return ticket!=0 && OrderSelect(ticket) && OrderGetInteger(ORDER_MAGIC)==OrdersID && OrderGetString(ORDER_SYMBOL)==SymbolTrade; }
bool TradeOK(){ uint r=trade.ResultRetcode(); return r==TRADE_RETCODE_DONE || r==TRADE_RETCODE_DONE_PARTIAL || r==TRADE_RETCODE_PLACED; }
double NormalizeVolume(double v){
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX),st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);
   if(mn<=0) mn=0.01; if(st<=0) st=0.01; if(mx<=0) mx=v; v=MathMax(mn,MathMin(mx,v)); v=MathRound(v/st)*st; v=MathMax(mn,MathMin(mx,v)); return NormalizeDouble(v,(st<0.01)?3:2);
}
double GetRSI(){ double b[]; ArraySetAsSeries(b,true); return CopyBuffer(HandleRSI,0,0,1,b)>0?b[0]:50.0; }
double GetMA(int shift=0){ double b[]; ArraySetAsSeries(b,true); return CopyBuffer(HandleMA,0,shift,1,b)>0?b[0]:0.0; }

//================ NEWS =================//
bool IsNewsEngineAllowed(){ if(!EnableNewsFilter) return false; if(MQLInfoInteger(MQL_TESTER)&&!EnableNewsInTester) return false; return true; }
bool NewsImportanceAllowed(long importance){ return !NewsHighImpactOnly || importance==CALENDAR_IMPORTANCE_HIGH; }
void UpdateNewsStatus(){
   NewsBlockActive=false; NewsCloseWindow=false; NextNewsTime=0; NextNewsName=""; NextNewsCurrency=""; NextNewsImportance=0; ActiveNewsTime=0; ActiveNewsName=""; ActiveNewsCurrency=""; NewsLastScan=TimeTradeServer();
   if(!IsNewsEngineAllowed()) return;
   datetime now=TimeTradeServer(); if(now<=0) now=TimeCurrent();
   MqlCalendarValue values[]; int total=CalendarValueHistory(values,now-86400,now+3*86400,"",NewsCurrency); if(total<=0) return;
   for(int i=0;i<total;i++){
      ulong eid=values[i].event_id; MqlCalendarEvent event; if(!CalendarEventById(eid,event)) continue; if(!NewsImportanceAllowed((long)event.importance)) continue;
      MqlCalendarCountry country; if(!CalendarCountryById(event.country_id,country)) continue; if(NewsCurrency!=""&&country.currency!=NewsCurrency) continue;
      datetime eventTime=values[i].time; if(eventTime<=0) continue;
      long before=(long)MathMax(0,NewsBeforeMinutes)*60, after=(long)MathMax(0,NewsAfterMinutes)*60, closeBefore=(long)MathMax(0,CloseBeforeNewsMinutes)*60;
      bool inBlock=now>=eventTime-before && now<=eventTime+after, inClose=CloseBeforeNews && now>=eventTime-closeBefore && now<eventTime;
      if(inBlock){ NewsBlockActive=true; if(ActiveNewsTime==0||eventTime>ActiveNewsTime){ActiveNewsTime=eventTime;ActiveNewsName=event.name;ActiveNewsCurrency=country.currency;} }
      if(inClose){ NewsCloseWindow=true; if(ActiveNewsTime==0||eventTime<ActiveNewsTime){ActiveNewsTime=eventTime;ActiveNewsName=event.name;ActiveNewsCurrency=country.currency;} }
      if(eventTime>=now&&(NextNewsTime==0||eventTime<NextNewsTime)){NextNewsTime=eventTime;NextNewsName=event.name;NextNewsCurrency=country.currency;NextNewsImportance=(long)event.importance;}
   }
}
string NewsStatusText(){ if(!IsNewsEngineAllowed()) return "OFF"; if(NewsCloseWindow) return "CLOSE"; if(NewsBlockActive) return "BLOCKED"; return "CLEAR"; }
bool IsNewsBlockingRecovery(){ return IsNewsEngineAllowed()&&NewsBlockActive&&BlockRecovery; }
bool IsNewsBlockingPrimary(){ if(!IsNewsEngineAllowed()||!NewsBlockActive) return false; return (BuyOrders==0&&SellOrders==0)?BlockNewEntries:BlockGridExpansion; }
string NewsNextText(){ if(!IsNewsEngineAllowed()) return "N/A"; if(NextNewsTime==0) return "NONE"; return StringFormat("%s %s | %s",NextNewsCurrency,NextNewsName,TimeToString(NextNewsTime,TIME_DATE|TIME_MINUTES)); }
bool ManageNewsProtection(){ if(!IsNewsEngineAllowed()||!NewsCloseWindow) return false; DeleteRecoveryPending(); CloseAllExposure(); return true; }

//================ CORE ENGINE =================//
int OnInit(){
   SymbolTrade=_Symbol; OrdersID=(MagicNumber==0)?101010:MagicNumber; InitialBalance=AccountInfoDouble(ACCOUNT_BALANCE); HighWaterMark=InitialBalance;
   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE); HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);
   trade.SetExpertMagicNumber(OrdersID); trade.SetDeviationInPoints(10); trade.SetTypeFillingBySymbol(SymbolTrade);
   if(HandleRSI==INVALID_HANDLE||HandleMA==INVALID_HANDLE) return INIT_FAILED; if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING) return INIT_FAILED;
   ResetDailyTargetIfNewDay(); if(IsNewsEngineAllowed()){EventSetTimer(MathMax(1,NewsRefreshSeconds));UpdateNewsStatus();} UpdateStatus(); return INIT_SUCCEEDED;
}
void OnDeinit(const int reason){ if(IsNewsEngineAllowed()) EventKillTimer(); IndicatorRelease(HandleRSI); IndicatorRelease(HandleMA); DeleteDashboard(); Comment(""); }
void OnTimer(){ UpdateNewsStatus(); }
void OnTick(){
   if(IsTerminated||!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return; ResetDailyTargetIfNewDay(); UpdateStatus();
   double balance=AccountInfoDouble(ACCOUNT_BALANCE),equity=AccountInfoDouble(ACCOUNT_EQUITY); if(balance>HighWaterMark) HighWaterMark=balance;
   double dd=(equity<balance&&balance>0)?(balance-equity)/balance*100.0:0.0;
   if(dd>=MaxEquityLossPercent){DeleteRecoveryPending();CloseBasket();IsTerminated=true;return;}
   if(CheckDailyTarget()){DisplayDashboard(dd);return;} ManageBasketExit(); UpdateStatus(); if(CheckDailyTarget()){DisplayDashboard(dd);return;}
   if(UseTradingHour&&!IsTradingHour()){CloseAllExposure();DisplayDashboard(dd);return;} if(ManageNewsProtection()){DisplayDashboard(dd);return;}
   if(RecoveryActive){if(!IsNewsBlockingRecovery())ManageRecoveryStage2();DisplayDashboard(dd);return;}
   if(BuyOrders>=MaxOrders&&SellOrders==0){if(!IsNewsBlockingRecovery())ManageRecoveryStage1(POSITION_TYPE_BUY);DisplayDashboard(dd);return;}
   if(SellOrders>=MaxOrders&&BuyOrders==0){if(!IsNewsBlockingRecovery())ManageRecoveryStage1(POSITION_TYPE_SELL);DisplayDashboard(dd);return;}
   if(!IsNewsBlockingPrimary()) ManagePrimaryGrid(); DisplayDashboard(dd);
}
void UpdateStatus(){
   BuyOrders=SellOrders=0; BuyLots=SellLots=0; BuyProfit=SellProfit=0; LastBuyPrice=LastSellPrice=0; LastBuyTime=LastSellTime=0; RecoveryStage=0;
   Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0; Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0; Recovery1Type=WRONG_VALUE; Recovery2Type=WRONG_VALUE;
   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i); if(!IsOurPosition(ticket)) continue; ENUM_POSITION_TYPE type=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE); double lot=PositionGetDouble(POSITION_VOLUME); double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP); double open=PositionGetDouble(POSITION_PRICE_OPEN); datetime tm=(datetime)PositionGetInteger(POSITION_TIME); string c=PositionGetString(POSITION_COMMENT);
      bool r1=StringFind(c,"RECOVERY 1 BUY")>=0||StringFind(c,"RECOVERY 1 SELL")>=0, r2=StringFind(c,"RECOVERY 2 BUY")>=0||StringFind(c,"RECOVERY 2 SELL")>=0;
      if(r1){Recovery1Lots+=lot;Recovery1Profit+=p;Recovery1EntryPrice=open;Recovery1Type=type;RecoveryStage=MathMax(RecoveryStage,1);continue;} if(r2){Recovery2Lots+=lot;Recovery2Profit+=p;Recovery2EntryPrice=open;Recovery2Type=type;RecoveryStage=MathMax(RecoveryStage,2);continue;}
      if(type==POSITION_TYPE_BUY){BuyOrders++;BuyLots+=lot;BuyProfit+=p;if(tm>=LastBuyTime){LastBuyTime=tm;LastBuyPrice=open;}}
      else if(type==POSITION_TYPE_SELL){SellOrders++;SellLots+=lot;SellProfit+=p;if(tm>=LastSellTime){LastSellTime=tm;LastSellPrice=open;}}
   }
   RecoveryLots=Recovery1Lots+Recovery2Lots; RecoveryProfit=Recovery1Profit+Recovery2Profit; RecoveryActive=(RecoveryStage>0); BasketProfitValue=BuyProfit+SellProfit+RecoveryProfit;
}
bool HasRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){ ulong ticket=OrderGetTicket(i); if(!IsOurOrder(ticket)) continue; string c=OrderGetString(ORDER_COMMENT); if(StringFind(c,"RECOVERY 1 BUY")>=0||StringFind(c,"RECOVERY 1 SELL")>=0||StringFind(c,"RECOVERY 2 BUY")>=0||StringFind(c,"RECOVERY 2 SELL")>=0) return true; }
   return false;
}
void DeleteRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){ ulong ticket=OrderGetTicket(i); if(!IsOurOrder(ticket)) continue; string c=OrderGetString(ORDER_COMMENT); if(StringFind(c,"RECOVERY 1 BUY")<0&&StringFind(c,"RECOVERY 1 SELL")<0&&StringFind(c,"RECOVERY 2 BUY")<0&&StringFind(c,"RECOVERY 2 SELL")<0) continue; trade.OrderDelete(ticket); }
}
void ManageRecoveryStage1(ENUM_POSITION_TYPE primaryType){
   if(!EnableRecovery||RecoveryStage>0||HasRecoveryPending()) return; if(MaxRecoveryStages<1) return;
   double primaryPL=(primaryType==POSITION_TYPE_BUY)?BuyProfit:SellProfit; double primaryLots=(primaryType==POSITION_TYPE_BUY)?BuyLots:SellLots; double anchorPrice=(primaryType==POSITION_TYPE_BUY)?LastBuyPrice:LastSellPrice;
   if(RecoveryOnlyWhenMinus&&primaryPL>=0.0) return; if(primaryLots<=0||anchorPrice<=0) return;
   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT); if(point<=0) return; double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);
   double adversePoints=(primaryType==POSITION_TYPE_BUY)?(anchorPrice-bid)/point:(ask-anchorPrice)/point; if(adversePoints<Recovery1GapPoints) return;
   UpdateStatus(); double basketBefore=BasketProfitValue; if(RecoveryOnlyWhenMinus&&basketBefore>=0.0) return;
   double lot=NormalizeVolume(primaryLots*Recovery1Multiplier); if(Recovery1MaxLot>0.0) lot=NormalizeVolume(MathMin(lot,Recovery1MaxLot)); if(lot<=0) return;
   trade.SetExpertMagicNumber(OrdersID); trade.SetTypeFillingBySymbol(SymbolTrade); bool ok=false; string c;
   if(primaryType==POSITION_TYPE_BUY){ c=CommentsOrders+" RECOVERY 1 SELL"; ok=trade.Sell(lot,SymbolTrade,0,0,0,c); }
   else{ c=CommentsOrders+" RECOVERY 1 BUY"; ok=trade.Buy(lot,SymbolTrade,0,0,0,c); }
   if(ok&&TradeOK()) PrintFormat("V19 R1 OPEN | MaxOrders=%d | primary=%s | basket=%.2f | primaryLots=%.2f | R1Lot=%.2f | adverse=%.0f",MaxOrders,primaryType==POSITION_TYPE_BUY?"BUY":"SELL",basketBefore,primaryLots,lot,adversePoints);
   else PrintFormat("V19 R1 FAILED | MaxOrders=%d | basket=%.2f | lot=%.2f | retcode=%u | %s",MaxOrders,basketBefore,lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
}
void ManageRecoveryStage2(){
   if(!EnableRecovery||RecoveryStage!=1||MaxRecoveryStages<2) return; if(Recovery1Lots<=0||Recovery1EntryPrice<=0) return; if(Recovery1Profit>=0.0) return; if(RecoveryOnlyWhenMinus&&BasketProfitValue>=0.0) return;
   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT); if(point<=0) return; double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),adversePoints=0;
   if(Recovery1Type==POSITION_TYPE_BUY) adversePoints=(Recovery1EntryPrice-bid)/point; else if(Recovery1Type==POSITION_TYPE_SELL) adversePoints=(ask-Recovery1EntryPrice)/point; else return;
   if(adversePoints<Recovery2GapPoints) return; double baseLots=BuyLots+SellLots; if(baseLots<=0) return;
   double lot=NormalizeVolume(baseLots*Recovery2Multiplier); if(Recovery2MaxLot>0.0) lot=NormalizeVolume(MathMin(lot,Recovery2MaxLot)); if(lot<=0) return;
   trade.SetExpertMagicNumber(OrdersID); trade.SetTypeFillingBySymbol(SymbolTrade); bool ok=false; string c;
   if(Recovery1Type==POSITION_TYPE_BUY){ c=CommentsOrders+" RECOVERY 2 SELL"; ok=trade.Sell(lot,SymbolTrade,0,0,0,c); }
   else{ c=CommentsOrders+" RECOVERY 2 BUY"; ok=trade.Buy(lot,SymbolTrade,0,0,0,c); }
   if(ok&&TradeOK()) PrintFormat("V19 R2 OPEN | MaxOrders=%d | basket=%.2f | R1PL=%.2f | R2Lot=%.2f | adverse=%.0f",MaxOrders,BasketProfitValue,Recovery1Profit,lot,adversePoints);
   else PrintFormat("V19 R2 FAILED | MaxOrders=%d | basket=%.2f | lot=%.2f | retcode=%u | %s",MaxOrders,BasketProfitValue,lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
}
void ManagePrimaryGrid(){
   UpdateStatus(); if(BuyOrders>0&&SellOrders>0) return; double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT); if(point<=0) return;
   if(BuyOrders>0&&BuyOrders<MaxOrders){
      double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),profitGap=PointsForProfitGap*point,lossGap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1)*point;
      if(EnableProfitDirection&&BuyProfit>0.0){ if(ask>=LastBuyPrice+profitGap){ExecutePrimary(ORDER_TYPE_BUY);return;} return; }
      if(BuyProfit<=0.0&&ask<=LastBuyPrice-lossGap){ExecutePrimary(ORDER_TYPE_BUY);return;} return;
   }
   if(SellOrders>0&&SellOrders<MaxOrders){
      double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),profitGap=PointsForProfitGap*point,lossGap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1)*point;
      if(EnableProfitDirection&&SellProfit>0.0){ if(bid<=LastSellPrice-profitGap){ExecutePrimary(ORDER_TYPE_SELL);return;} return; }
      if(SellProfit<=0.0&&bid>=LastSellPrice+lossGap){ExecutePrimary(ORDER_TYPE_SELL);return;} return;
   }
   if(BuyOrders==0&&SellOrders==0){
      double r=GetRSI(),ma=GetMA(0),price=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
      if(TypeOrdersPlace!=Open__Only_Sell&&ma>0&&price>ma&&r<RSILower){ExecutePrimary(ORDER_TYPE_BUY);return;}
      if(TypeOrdersPlace!=Open__Only_Buy&&ma>0&&price<ma&&r>RSIUpper){ExecutePrimary(ORDER_TYPE_SELL);return;}
   }
}
bool ExecutePrimary(ENUM_ORDER_TYPE type){
   int count=(type==ORDER_TYPE_BUY)?BuyOrders:SellOrders; if(count>=MaxOrders) return false; double lot=NormalizeVolume(ManualLotSize*(count+1));
   string c=(type==ORDER_TYPE_BUY)?StringFormat("%s PRIMARY BUY %d",CommentsOrders,count+1):StringFormat("%s PRIMARY SELL %d",CommentsOrders,count+1);
   trade.SetExpertMagicNumber(OrdersID); trade.SetTypeFillingBySymbol(SymbolTrade); bool ok=(type==ORDER_TYPE_BUY)?trade.Buy(lot,SymbolTrade,0,0,0,c):trade.Sell(lot,SymbolTrade,0,0,0,c);
   if(ok&&TradeOK()) return true; PrintFormat("V19 PRIMARY FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription()); return false;
}
void ManageBasketExit(){
   UpdateStatus(); int total=BuyOrders+SellOrders+((RecoveryStage>0)?1:0)+((RecoveryStage>1)?1:0); if(total==0){BasketPeakProfit=0;BasketTrailingActive=false;return;}
   double p=BasketProfitValue;
   if(UseTrailingProfit){
      double arm=MathMax(TargetProfitUSD,TrailingStartUSD);
      if(!BasketTrailingActive&&p>=arm){BasketTrailingActive=true;BasketPeakProfit=p;PrintFormat("V19 BASKET TARGET REACHED -> TRAILING ON | basket=%.2f | stage=%d",p,RecoveryStage);}
      if(BasketTrailingActive){ if(p>BasketPeakProfit) BasketPeakProfit=p; if(p<=BasketPeakProfit-TrailingStopUSD){PrintFormat("V19 BASKET TRAILING CLOSE | peak=%.2f | current=%.2f | stage=%d",BasketPeakProfit,p,RecoveryStage);DeleteRecoveryPending();CloseBasket();} }
   }
   else if(p>=TargetProfitUSD){DeleteRecoveryPending();CloseBasket();}
}
void CloseAllExposure(){
   for(int i=OrdersTotal()-1;i>=0;i--){ ulong ticket=OrderGetTicket(i); if(!IsOurOrder(ticket)) continue; trade.OrderDelete(ticket); }
   for(int i=PositionsTotal()-1;i>=0;i--){ ulong ticket=PositionGetTicket(i); if(!IsOurPosition(ticket)) continue; trade.PositionClose(ticket); }
   BasketPeakProfit=0;BasketTrailingActive=false;
}
void CloseBasket(){
   for(int i=PositionsTotal()-1;i>=0;i--){ ulong ticket=PositionGetTicket(i); if(!IsOurPosition(ticket)) continue; trade.PositionClose(ticket); }
   BasketPeakProfit=0;BasketTrailingActive=false;
}

