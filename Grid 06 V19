double GetDailyRealizedProfit(){MqlDateTime dt;TimeToStruct(GetStrategyTime(),dt);dt.hour=0;dt.min=0;dt.sec=0;datetime a=StructToTime(dt),b=GetStrategyTime();if(!SelectStrategyHistory(a,b))return 0.0;double r=0.0;for(int i=0;i<HistoryDealsTotal();i++){ulong t=HistoryDealGetTicket(i);if(t==0)continue;if((long)HistoryDealGetInteger(t,DEAL_MAGIC)!=OrdersID)continue;if(HistoryDealGetString(t,DEAL_SYMBOL)!=SymbolTrade)continue;long e=HistoryDealGetInteger(t,DEAL_ENTRY);if(e!=DEAL_ENTRY_OUT&&e!=DEAL_ENTRY_OUT_BY&&e!=DEAL_ENTRY_INOUT)continue;r+=HistoryDealGetDouble(t,DEAL_PROFIT)+HistoryDealGetDouble(t,DEAL_SWAP)+HistoryDealGetDouble(t,DEAL_COMMISSION)+HistoryDealGetDouble(t,DEAL_FEE);}return r;}
