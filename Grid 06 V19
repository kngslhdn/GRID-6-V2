void ManagePrimaryGrid(){
   UpdateStatus();if(BuyOrders>0&&SellOrders>0)return;double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);if(point<=0)return;
   if(BuyOrders>0&&BuyOrders<MaxOrders){double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),profitGap=PointsForProfitGap*point,lossGap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1)*point;if(EnableProfitDirection&&BuyProfit>0){if(ask>=LastBuyPrice+profitGap){ExecutePrimary(ORDER_TYPE_BUY);}return;}if(BuyProfit<=0&&ask<=LastBuyPrice-lossGap)ExecutePrimary(ORDER_TYPE_BUY);return;}
   if(SellOrders>0&&SellOrders<MaxOrders){double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),profitGap=PointsForProfitGap*point,lossGap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1)*point;if(EnableProfitDirection&&SellProfit>0){if(bid<=LastSellPrice-profitGap)ExecutePrimary(ORDER_TYPE_SELL);return;}if(SellProfit<=0&&bid>=LastSellPrice+lossGap)ExecutePrimary(ORDER_TYPE_SELL);return;}
   if(BuyOrders==0&&SellOrders==0){double r=GetRSI(),ma=GetMA(0),price=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);if(TypeOrdersPlace!=Open__Only_Sell&&ma>0&&price>ma&&r<RSILower){ExecutePrimary(ORDER_TYPE_BUY);return;}if(TypeOrdersPlace!=Open__Only_Buy&&ma>0&&price<ma&&r>RSIUpper)ExecutePrimary(ORDER_TYPE_SELL);}
}
bool ExecutePrimary(ENUM_ORDER_TYPE type){int count=(type==ORDER_TYPE_BUY)?BuyOrders:SellOrders;if(count>=MaxOrders)return false;double lot=NormalizeVolume(ManualLotSize*(count+1));string c=(type==ORDER_TYPE_BUY)?StringFormat("%s PRIMARY BUY %d",CommentsOrders,count+1):StringFormat("%s PRIMARY SELL %d",CommentsOrders,count+1);trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok=(type==ORDER_TYPE_BUY)?trade.Buy(lot,SymbolTrade,0,0,0,c):trade.Sell(lot,SymbolTrade,0,0,0,c);return ok&&TradeOK();}
void ManageBasketExit(){UpdateStatus();int total=BuyOrders+SellOrders+((RecoveryStage>0)?1:0)+((RecoveryStage>1)?1:0);if(total==0){BasketPeakProfit=0;BasketTrailingActive=false;return;}double p=BasketProfitValue;if(UseTrailingProfit){double arm=MathMax(TargetProfitUSD,TrailingStartUSD);if(!BasketTrailingActive&&p>=arm){BasketTrailingActive=true;BasketPeakProfit=p;}if(BasketTrailingActive){if(p>BasketPeakProfit)BasketPeakProfit=p;if(p<=BasketPeakProfit-TrailingStopUSD){DeleteRecoveryPending();CloseBasket();}}}else if(p>=TargetProfitUSD){DeleteRecoveryPending();CloseBasket();}}
void CloseAllExposure(){for(int i=OrdersTotal()-1;i>=0;i--){ulong ticket=OrderGetTicket(i);if(IsOurOrder(ticket))trade.OrderDelete(ticket);}for(int i=PositionsTotal()-1;i>=0;i--){ulong ticket=PositionGetTicket(i);if(IsOurPosition(ticket))trade.PositionClose(ticket);}BasketPeakProfit=0;BasketTrailingActive=false;}
