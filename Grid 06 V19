   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE); HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);
   trade.SetExpertMagicNumber(OrdersID); trade.SetDeviationInPoints(10); trade.SetTypeFillingBySymbol(SymbolTrade);
   if(HandleRSI==INVALID_HANDLE||HandleMA==INVALID_HANDLE) return INIT_FAILED; if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING) return INIT_FAILED;
   ResetDailyTargetIfNewDay(); if(IsNewsEngineAllowed()){EventSetTimer(MathMax(1,NewsRefreshSeconds));UpdateNewsStatus();} UpdateStatus(); return INIT_SUCCEEDED;
}
void OnDeinit(const int reason){ if(IsNewsEngineAllowed()) EventKillTimer(); IndicatorRelease(HandleRSI); IndicatorRelease(HandleMA); DeleteDashboard(); Comment(""); }
void OnTimer(){ UpdateNewsStatus(); }
void OnTick(){
   if(IsTerminated||!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return; ResetDailyTargetIfNewDay(); UpdateStatus();
   double balance=AccountInfoDouble(ACCOUNT_BALANCE),equity=AccountInfoDouble(ACCOUNT_EQUITY); if(balance>HighWaterMark) HighWaterMark=balance;
   double dd=(equity<balance&&balance>0)?(balance-equity)/balance*100.0:0.0;
   if(dd>=MaxEquityLossPercent){DeleteRecoveryPending();CloseBasket();IsTerminated=true;return;}
   if(CheckDailyTarget()){DisplayDashboard(dd);return;} ManageBasketExit(); UpdateStatus(); if(CheckDailyTarget()){DisplayDashboard(dd);return;}
   if(UseTradingHour&&!IsTradingHour()){CloseAllExposure();DisplayDashboard(dd);return;} if(ManageNewsProtection()){DisplayDashboard(dd);return;}
   if(RecoveryActive){if(!IsNewsBlockingRecovery())ManageRecoveryStage2();DisplayDashboard(dd);return;}
   if(BuyOrders>=MaxOrders&&SellOrders==0){if(!IsNewsBlockingRecovery())ManageRecoveryStage1(POSITION_TYPE_BUY);DisplayDashboard(dd);return;}
   if(SellOrders>=MaxOrders&&BuyOrders==0){if(!IsNewsBlockingRecovery())ManageRecoveryStage1(POSITION_TYPE_SELL);DisplayDashboard(dd);return;}
   if(!IsNewsBlockingPrimary()) ManagePrimaryGrid(); DisplayDashboard(dd);
}
void UpdateStatus(){
   BuyOrders=SellOrders=0; BuyLots=SellLots=0; BuyProfit=SellProfit=0; LastBuyPrice=LastSellPrice=0; LastBuyTime=LastSellTime=0; RecoveryStage=0;
   Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0; Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0; Recovery1Type=WRONG_VALUE; Recovery2Type=WRONG_VALUE;
   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i); if(!IsOurPosition(ticket)) continue; ENUM_POSITION_TYPE type=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE); double lot=PositionGetDouble(POSITION_VOLUME); double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP); double open=PositionGetDouble(POSITION_PRICE_OPEN); datetime tm=(datetime)PositionGetInteger(POSITION_TIME); string c=PositionGetString(POSITION_COMMENT);
      bool r1=StringFind(c,"RECOVERY 1 BUY")>=0||StringFind(c,"RECOVERY 1 SELL")>=0, r2=StringFind(c,"RECOVERY 2 BUY")>=0||StringFind(c,"RECOVERY 2 SELL")>=0;
      if(r1){Recovery1Lots+=lot;Recovery1Profit+=p;Recovery1EntryPrice=open;Recovery1Type=type;RecoveryStage=MathMax(RecoveryStage,1);continue;} if(r2){Recovery2Lots+=lot;Recovery2Profit+=p;Recovery2EntryPrice=open;Recovery2Type=type;RecoveryStage=MathMax(RecoveryStage,2);continue;}
      if(type==POSITION_TYPE_BUY){BuyOrders++;BuyLots+=lot;BuyProfit+=p;if(tm>=LastBuyTime){LastBuyTime=tm;LastBuyPrice=open;}}
      else if(type==POSITION_TYPE_SELL){SellOrders++;SellLots+=lot;SellProfit+=p;if(tm>=LastSellTime){LastSellTime=tm;LastSellPrice=open;}}
   }
   RecoveryLots=Recovery1Lots+Recovery2Lots; RecoveryProfit=Recovery1Profit+Recovery2Profit; RecoveryActive=RecoveryStage>0; BasketProfitValue=BuyProfit+SellProfit+RecoveryProfit;
}
bool HasRecoveryPending(){for(int i=OrdersTotal()-1;i>=0;i--){ulong ticket=OrderGetTicket(i);if(!IsOurOrder(ticket))continue;string c=OrderGetString(ORDER_COMMENT);if(StringFind(c,"RECOVERY 1 BUY")>=0||StringFind(c,"RECOVERY 1 SELL")>=0||StringFind(c,"RECOVERY 2 BUY")>=0||StringFind(c,"RECOVERY 2 SELL")>=0)return true;}return false;}
void DeleteRecoveryPending(){for(int i=OrdersTotal()-1;i>=0;i--){ulong ticket=OrderGetTicket(i);if(!IsOurOrder(ticket))continue;string c=OrderGetString(ORDER_COMMENT);if(StringFind(c,"RECOVERY 1 BUY")<0&&StringFind(c,"RECOVERY 1 SELL")<0&&StringFind(c,"RECOVERY 2 BUY")<0&&StringFind(c,"RECOVERY 2 SELL")<0)continue;trade.OrderDelete(ticket);}}
void ManageRecoveryStage1(ENUM_POSITION_TYPE primaryType){
   if(!EnableRecovery||RecoveryStage>0||HasRecoveryPending()||MaxRecoveryStages<1)return; double primaryPL=(primaryType==POSITION_TYPE_BUY)?BuyProfit:SellProfit, primaryLots=(primaryType==POSITION_TYPE_BUY)?BuyLots:SellLots, anchorPrice=(primaryType==POSITION_TYPE_BUY)?LastBuyPrice:LastSellPrice; if(RecoveryOnlyWhenMinus&&primaryPL>=0)return; if(primaryLots<=0||anchorPrice<=0)return;
   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);if(point<=0)return;double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);double adversePoints=(primaryType==POSITION_TYPE_BUY)?(anchorPrice-bid)/point:(ask-anchorPrice)/point;if(adversePoints<Recovery1GapPoints)return;UpdateStatus();double basketBefore=BasketProfitValue;if(RecoveryOnlyWhenMinus&&basketBefore>=0)return;
   double lot=NormalizeVolume(primaryLots*Recovery1Multiplier);if(Recovery1MaxLot>0)lot=NormalizeVolume(MathMin(lot,Recovery1MaxLot));if(lot<=0)return;trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok=false;string c;
   if(primaryType==POSITION_TYPE_BUY){c=CommentsOrders+" RECOVERY 1 SELL";ok=trade.Sell(lot,SymbolTrade,0,0,0,c);}else{c=CommentsOrders+" RECOVERY 1 BUY";ok=trade.Buy(lot,SymbolTrade,0,0,0,c);} if(!ok||!TradeOK())PrintFormat("V19 R1 FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription());
}
void ManageRecoveryStage2(){
   if(!EnableRecovery||RecoveryStage!=1||MaxRecoveryStages<2||Recovery1Lots<=0||Recovery1EntryPrice<=0||Recovery1Profit>=0)return; if(RecoveryOnlyWhenMinus&&BasketProfitValue>=0)return;
   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);if(point<=0)return;double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),adversePoints=0; if(Recovery1Type==POSITION_TYPE_BUY)adversePoints=(Recovery1EntryPrice-bid)/point;else if(Recovery1Type==POSITION_TYPE_SELL)adversePoints=(ask-Recovery1EntryPrice)/point;else return; if(adversePoints<Recovery2GapPoints)return;
   double baseLots=BuyLots+SellLots;if(baseLots<=0)return;double lot=NormalizeVolume(baseLots*Recovery2Multiplier);if(Recovery2MaxLot>0)lot=NormalizeVolume(MathMin(lot,Recovery2MaxLot));if(lot<=0)return;trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok=false;string c;
   if(Recovery1Type==POSITION_TYPE_BUY){c=CommentsOrders+" RECOVERY 2 SELL";ok=trade.Sell(lot,SymbolTrade,0,0,0,c);}else{c=CommentsOrders+" RECOVERY 2 BUY";ok=trade.Buy(lot,SymbolTrade,0,0,0,c);}if(!ok||!TradeOK())PrintFormat("V19 R2 FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription());
