void ManageRecoveryStage1(ENUM_POSITION_TYPE ty){if(!EnableRecovery||RecoveryStage>0||HasRecoveryPending()||MaxRecoveryStages<1)return;double pl=ty==POSITION_TYPE_BUY?BuyProfit:SellProfit,lots=ty==POSITION_TYPE_BUY?BuyLots:SellLots,anchor=ty==POSITION_TYPE_BUY?LastBuyPrice:LastSellPrice;if(RecoveryOnlyWhenMinus&&pl>=0)return;if(lots<=0||anchor<=0)return;double pt=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);if(pt<=0)return;double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),adv=ty==POSITION_TYPE_BUY?(anchor-bid)/pt:(ask-anchor)/pt;if(adv<Recovery1GapPoints)return;UpdateStatus();if(RecoveryOnlyWhenMinus&&BasketProfitValue>=0)return;double lot=NormalizeVolume(lots*Recovery1Multiplier);if(Recovery1MaxLot>0)lot=NormalizeVolume(MathMin(lot,Recovery1MaxLot));if(lot<=0)return;trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok=ty==POSITION_TYPE_BUY?trade.Sell(lot,SymbolTrade,0,0,0,CommentsOrders+" RECOVERY 1 SELL"):trade.Buy(lot,SymbolTrade,0,0,0,CommentsOrders+" RECOVERY 1 BUY");if(!ok||!TradeOK())PrintFormat("V19 R1 FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription());}
void ManageRecoveryStage2(){if(!EnableRecovery||RecoveryStage!=1||MaxRecoveryStages<2||Recovery1Lots<=0||Recovery1EntryPrice<=0||Recovery1Profit>=0||(RecoveryOnlyWhenMinus&&BasketProfitValue>=0))return;double pt=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);if(pt<=0)return;double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID),ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK),adv=0;if(Recovery1Type==POSITION_TYPE_BUY)adv=(Recovery1EntryPrice-bid)/pt;else if(Recovery1Type==POSITION_TYPE_SELL)adv=(ask-Recovery1EntryPrice)/pt;else return;if(adv<Recovery2GapPoints)return;double base=BuyLots+SellLots;if(base<=0)return;double lot=NormalizeVolume(base*Recovery2Multiplier);if(Recovery2MaxLot>0)lot=NormalizeVolume(MathMin(lot,Recovery2MaxLot));if(lot<=0)return;trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok=Recovery1Type==POSITION_TYPE_BUY?trade.Sell(lot,SymbolTrade,0,0,0,CommentsOrders+" RECOVERY 2 SELL"):trade.Buy(lot,SymbolTrade,0,0,0,CommentsOrders+" RECOVERY 2 BUY");if(!ok||!TradeOK())PrintFormat("V19 R2 FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription());}
