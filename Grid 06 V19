void UpdateNewsStatus(){NewsBlockActive=false;NewsCloseWindow=false;NextNewsTime=0;NextNewsName="";NextNewsCurrency="";ActiveNewsTime=0;ActiveNewsName="";ActiveNewsCurrency="";NewsLastScan=TimeTradeServer();if(!IsNewsEngineAllowed())return;datetime n=TimeTradeServer();if(n<=0)n=TimeCurrent();MqlCalendarValue v[];int total=CalendarValueHistory(v,n-86400,n+3*86400,"",NewsCurrency);if(total<=0)return;for(int i=0;i<total;i++){ulong eid=v[i].event_id;MqlCalendarEvent e;if(!CalendarEventById(eid,e))continue;if(!NewsImportanceAllowed((long)e.importance))continue;MqlCalendarCountry c;if(!CalendarCountryById(e.country_id,c))continue;if(NewsCurrency!=""&&c.currency!=NewsCurrency)continue;datetime et=v[i].time;if(et<=0)continue;long pre=(long)MathMax(0,NewsBeforeMinutes)*60,post=(long)MathMax(0,NewsAfterMinutes)*60,cb=(long)MathMax(0,CloseBeforeNewsMinutes)*60;bool blk=n>=et-pre&&n<=et+post,cl=CloseBeforeNews&&n>=et-cb&&n<et;if(blk){NewsBlockActive=true;if(ActiveNewsTime==0||et>ActiveNewsTime){ActiveNewsTime=et;ActiveNewsName=e.name;ActiveNewsCurrency=c.currency;}}if(cl){NewsCloseWindow=true;if(ActiveNewsTime==0||et<ActiveNewsTime){ActiveNewsTime=et;ActiveNewsName=e.name;ActiveNewsCurrency=c.currency;}}if(et>=n&&(NextNewsTime==0||et<NextNewsTime)){NextNewsTime=et;NextNewsName=e.name;NextNewsCurrency=c.currency;NextNewsImportance=(long)e.importance;}}}
