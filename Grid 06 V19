int GetServerDayKey(){ MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt); return dt.year*1000+dt.day_of_year; }
void ResetDailyTargetIfNewDay(){
   MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt);
   if(DailyTargetYear==dt.year && DailyTargetDayOfYear==dt.day_of_year) return;
   DailyTargetYear=dt.year; DailyTargetDayOfYear=dt.day_of_year;
   DailyStartBalance=AccountInfoDouble(ACCOUNT_BALANCE); DailyTargetReached=false;
