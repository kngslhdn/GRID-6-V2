   ArraySetAsSeries(b,true);
   return CopyBuffer(HandleMA,0,shift,1,b)>0 ? b[0] : 0.0;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsNewsEngineAllowed                                    |
//+------------------------------------------------------------------+
bool IsNewsEngineAllowed()
{
   if(!EnableNewsFilter) return false;
   if(MQLInfoInteger(MQL_TESTER) && !EnableNewsInTester) return false;
   return true;
}

//+------------------------------------------------------------------+
//| FUNCTION: NewsImportanceAllowed                                  |
//+------------------------------------------------------------------+
bool NewsImportanceAllowed(long importance)
{
   if(!NewsHighImpactOnly) return true;
   return importance==CALENDAR_IMPORTANCE_HIGH;
}

//+------------------------------------------------------------------+
//| FUNCTION: UpdateNewsStatus                                      |
//+------------------------------------------------------------------+
void UpdateNewsStatus()
{
   NewsBlockActive=false;
   NewsCloseWindow=false;
   NextNewsTime=0;
   ActiveNewsTime=0;
   NextNewsName="";
   NextNewsCurrency="";
   ActiveNewsName="";
   ActiveNewsCurrency="";
   NextNewsImportance=0;

   if(!IsNewsEngineAllowed()) return;

   datetime now=TimeTradeServer();
   if(now<=0) now=TimeCurrent();
   NewsLastScan=now;

   MqlCalendarValue values[];
   int total=CalendarValueHistory(values,now-86400,now+3*86400,"",NewsCurrency);
   if(total<=0) return;

   for(int i=0;i<total;i++)
   {
      ulong eventID=values[i].event_id;
      MqlCalendarEvent eventData;
      if(!CalendarEventById(eventID,eventData)) continue;
      if(!NewsImportanceAllowed((long)eventData.importance)) continue;

      MqlCalendarCountry countryData;
      if(!CalendarCountryById(eventData.country_id,countryData)) continue;
      if(NewsCurrency!="" && countryData.currency!=NewsCurrency) continue;

      datetime eventTime=values[i].time;
      if(eventTime<=0) continue;

      long before=(long)MathMax(0,NewsBeforeMinutes)*60;
      long after=(long)MathMax(0,NewsAfterMinutes)*60;
      long closeBefore=(long)MathMax(0,CloseBeforeNewsMinutes)*60;

      bool blocked=now>=eventTime-before && now<=eventTime+after;
      bool closeWindow=CloseBeforeNews && now>=eventTime-closeBefore && now<eventTime;

      if(blocked)
      {
         NewsBlockActive=true;

         if(ActiveNewsTime==0 || eventTime>ActiveNewsTime)
         {
            ActiveNewsTime=eventTime;
            ActiveNewsName=eventData.name;
            ActiveNewsCurrency=countryData.currency;
         }
      }

      if(closeWindow)
      {
         NewsCloseWindow=true;

         if(ActiveNewsTime==0 || eventTime<ActiveNewsTime)
         {
            ActiveNewsTime=eventTime;
            ActiveNewsName=eventData.name;
            ActiveNewsCurrency=countryData.currency;
         }
      }

      if(eventTime>=now && (NextNewsTime==0 || eventTime<NextNewsTime))
      {
         NextNewsTime=eventTime;
         NextNewsName=eventData.name;
         NextNewsCurrency=countryData.currency;
         NextNewsImportance=(long)eventData.importance;
      }
   }
}

