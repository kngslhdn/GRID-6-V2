void UpdateStatus(){BuyOrders=SellOrders=0;BuyLots=SellLots=0;BuyProfit=SellProfit=0;LastBuyPrice=LastSellPrice=0;LastBuyTime=LastSellTime=0;RecoveryStage=0;Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0;Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0;Recovery1Type=WRONG_VALUE;Recovery2Type=WRONG_VALUE;for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(!IsOurPosition(t))continue;ENUM_POSITION_TYPE ty=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);double lot=PositionGetDouble(POSITION_VOLUME),p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP),op=PositionGetDouble(POSITION_PRICE_OPEN);datetime tm=(datetime)PositionGetInteger(POSITION_TIME);string c=PositionGetString(POSITION_COMMENT);bool r1=StringFind(c,"RECOVERY 1 BUY")>=0||StringFind(c,"RECOVERY 1 SELL")>=0,r2=StringFind(c,"RECOVERY 2 BUY")>=0||StringFind(c,"RECOVERY 2 SELL")>=0;if(r1){Recovery1Lots+=lot;Recovery1Profit+=p;Recovery1EntryPrice=op;Recovery1Type=ty;RecoveryStage=MathMax(RecoveryStage,1);continue;}if(r2){Recovery2Lots+=lot;Recovery2Profit+=p;Recovery2EntryPrice=op;Recovery2Type=ty;RecoveryStage=MathMax(RecoveryStage,2);continue;}if(ty==POSITION_TYPE_BUY){BuyOrders++;BuyLots+=lot;BuyProfit+=p;if(tm>=LastBuyTime){LastBuyTime=tm;LastBuyPrice=op;}}else{SellOrders++;SellLots+=lot;SellProfit+=p;if(tm>=LastSellTime){LastSellTime=tm;LastSellPrice=op;}}}RecoveryLots=Recovery1Lots+Recovery2Lots;RecoveryProfit=Recovery1Profit+Recovery2Profit;RecoveryActive=RecoveryStage>0;BasketProfitValue=BuyProfit+SellProfit+RecoveryProfit;}
