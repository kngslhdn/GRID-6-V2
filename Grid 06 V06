//+------------------------------------------------------------------+
//| GRID 06.V07 - RECOVERY 1 + RECOVERY 2                          |
//+------------------------------------------------------------------+
#property strict
#property version "8.70"
#include <Trade/Trade.mqh>
CTrade trade;

enum Type {Open_Buy_And_Sell,Open__Only_Buy,Open__Only_Sell};
input double MaxEquityLossPercent=15.0;
input bool UseTrailingProfit=true;
input double TrailingStartUSD=5.0;
input double TrailingStopUSD=2.0;
input int MAPeriod=200;
input int RSIPeriod=14;
input int RSIUpper=61;
input int RSILower=41;
input Type TypeOrdersPlace=Open_Buy_And_Sell;
input double PointsForFirstGap=6250.0;
input double GapMultiplier=1.3;
input double TargetProfitUSD=5.0;
input double ManualLotSize=0.01;
input int MaxOrders=3;
input int MagicNumber=16082016;
input string CommentsOrders="GRID 06 V07";
input bool EnableRecoveryPending=true;
input double RecoveryMultiplier=1.50;
input int RecoveryTriggerOrders=3;
input double RecoveryGapPoints=6250.0;
input double MaxRecoveryLot=0.0;
input bool EnableRecovery2=true;
input double Recovery2Lot=0.20;
input bool Recovery2OnlyIfBasketNegative=true;
input bool UseTradingHour=true;
input int StartHour=7;
input int EndHour=22;

string SymbolTrade; int OrdersID,HandleRSI,HandleMA;
int BuyOrders,SellOrders; double BuyProfits,SellProfits,BuyLots,SellLots;
double PriceOpenLastBuy,PriceOpenLastSell,Buy3Price;
double Recovery1Profit,Recovery1Lots,Recovery2Profit,Recovery2Lots;
bool Recovery1Active=false,Recovery2Active=false,IsTerminated=false;
double HighWaterMark=0,InitialBalance=0,AdaptiveEquityBase=0,BasketPeakProfit=0;

bool IsTradingHour(){
   if(!UseTradingHour)return true; MqlDateTime dt; TimeToStruct(TimeCurrent(),dt);
   if(StartHour<EndHour)return dt.hour>=StartHour&&dt.hour<EndHour;
   return dt.hour>=StartHour||dt.hour<EndHour;
}
bool IsOurPosition(ulong t){
   if(t==0||!PositionSelectByTicket(t))return false;
   return PositionGetInteger(POSITION_MAGIC)==OrdersID&&PositionGetString(POSITION_SYMBOL)==SymbolTrade;
}
bool IsOurOrder(ulong t){
   if(t==0||!OrderSelect(t))return false;
   return OrderGetInteger(ORDER_MAGIC)==OrdersID&&OrderGetString(ORDER_SYMBOL)==SymbolTrade;
}
bool TradeOK(){uint r=trade.ResultRetcode();return r==TRADE_RETCODE_DONE||r==TRADE_RETCODE_DONE_PARTIAL||r==TRADE_RETCODE_PLACED;}
double NormalizeVolume(double v){
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN),mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX),st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);
   if(mn<=0)mn=0.01;if(st<=0)st=mn;if(mx<=0)mx=v;
   v=MathMax(mn,MathMin(mx,v));v=MathFloor(v/st+1e-9)*st;if(v<mn)v=mn;
   int d=(st<0.01)?3:2;if(st<0.001)d=4;return NormalizeDouble(v,d);
}

int OnInit(){
   SymbolTrade=_Symbol;OrdersID=(MagicNumber==0)?101010:MagicNumber;
   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE);
   HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);
   InitialBalance=AccountInfoDouble(ACCOUNT_BALANCE);AdaptiveEquityBase=InitialBalance;HighWaterMark=InitialBalance;
   trade.SetExpertMagicNumber(OrdersID);trade.SetDeviationInPoints(10);trade.SetTypeFillingBySymbol(SymbolTrade);
   if(HandleRSI==INVALID_HANDLE||HandleMA==INVALID_HANDLE)return INIT_FAILED;
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)return INIT_FAILED;
   UpdateStatus();return INIT_SUCCEEDED;
}
void OnDeinit(const int reason){IndicatorRelease(HandleRSI);IndicatorRelease(HandleMA);Comment("");}

void OnTick(){
   if(IsTerminated||!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))return;
   UpdateStatus();
   double bal=AccountInfoDouble(ACCOUNT_BALANCE),eq=AccountInfoDouble(ACCOUNT_EQUITY);
   double locked=bal-InitialBalance;if(locked<0)locked=0;AdaptiveEquityBase=InitialBalance+locked;if(bal>HighWaterMark)HighWaterMark=bal;
   double dd=(eq<AdaptiveEquityBase&&AdaptiveEquityBase>0)?(AdaptiveEquityBase-eq)/AdaptiveEquityBase*100.0:0;
   if(dd>=MaxEquityLossPercent){DeleteRecoveryPendings();CloseAllOrders();IsTerminated=true;return;}

   ManageRecovery2();
   ManageCombinedBasketExit();
   UpdateStatus();
   if(BuyOrders==0&&SellOrders==0&&!Recovery1Active&&!Recovery2Active){DeleteRecoveryPendings();BasketPeakProfit=0;}
   ManageRecoveryPending();
   if(!IsTradingHour()){DisplayDashboard(dd);return;}

   if(!Recovery1Active&&!Recovery2Active&&!HasRecoveryPending()){
      if(BuyOrders>0&&BuyOrders<MaxOrders){
         double gap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1);
         if(SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)<=PriceOpenLastBuy-gap*_Point)ExecutePrimary(ORDER_TYPE_BUY);
      }
      UpdateStatus();
      if(!Recovery1Active&&!Recovery2Active&&!HasRecoveryPending()&&SellOrders>0&&SellOrders<MaxOrders){
         double gap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1);
         if(SymbolInfoDouble(SymbolTrade,SYMBOL_BID)>=PriceOpenLastSell+gap*_Point)ExecutePrimary(ORDER_TYPE_SELL);
      }
   }

   UpdateStatus();
   if(BuyOrders==0&&SellOrders==0&&!Recovery1Active&&!Recovery2Active&&!HasRecoveryPending()){
      double r=GetRSI(),m=GetMA(),p=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);bool b=false,s=false;
      int lo=RSILower,hi=RSIUpper;if(bal<HighWaterMark){lo-=5;hi+=5;}
      if(TypeOrdersPlace!=Open__Only_Sell&&p>m&&r<lo)b=true;
      if(TypeOrdersPlace!=Open__Only_Buy&&p<m&&r>hi)s=true;
      if(b)ExecutePrimary(ORDER_TYPE_BUY);else if(s)ExecutePrimary(ORDER_TYPE_SELL);
   }
   UpdateStatus();ManageRecoveryPending();ManageRecovery2();DisplayDashboard(dd);
}

void UpdateStatus(){
   BuyOrders=SellOrders=0;BuyProfits=SellProfits=BuyLots=SellLots=0;
   PriceOpenLastBuy=PriceOpenLastSell=Buy3Price=0;Recovery1Profit=Recovery1Lots=Recovery2Profit=Recovery2Lots=0;
   Recovery1Active=Recovery2Active=false;datetime lb=0,ls=0;
   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong t=PositionGetTicket(i);if(!IsOurPosition(t))continue;
      ENUM_POSITION_TYPE ty=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP),v=PositionGetDouble(POSITION_VOLUME);
      datetime ot=(datetime)PositionGetInteger(POSITION_TIME);string c=PositionGetString(POSITION_COMMENT);
      bool r2=StringFind(c,"RECOVERY 2")>=0;
      bool r1=StringFind(c,"RECOVERY SELL STOP")>=0||StringFind(c,"RECOVERY BUY STOP")>=0||StringFind(c,"RECOVERY 1")>=0;
      if(r2){Recovery2Active=true;Recovery2Profit+=p;Recovery2Lots+=v;continue;}
      if(r1){Recovery1Active=true;Recovery1Profit+=p;Recovery1Lots+=v;continue;}
      if(ty==POSITION_TYPE_BUY){
         BuyOrders++;BuyProfits+=p;BuyLots+=v;
         if(ot>=lb){lb=ot;PriceOpenLastBuy=PositionGetDouble(POSITION_PRICE_OPEN);}
         if(StringFind(c,"PRIMARY BUY 3")>=0)Buy3Price=PositionGetDouble(POSITION_PRICE_OPEN);
      }else{
         SellOrders++;SellProfits+=p;SellLots+=v;
         if(ot>=ls){ls=ot;PriceOpenLastSell=PositionGetDouble(POSITION_PRICE_OPEN);}
      }
   }
}

bool HasRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){ulong t=OrderGetTicket(i);if(!IsOurOrder(t))continue;string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY SELL STOP")>=0||StringFind(c,"RECOVERY BUY STOP")>=0||StringFind(c,"RECOVERY 1")>=0)return true;}
   return false;
}
void DeleteRecoveryPendings(){
   for(int i=OrdersTotal()-1;i>=0;i--){ulong t=OrderGetTicket(i);if(!IsOurOrder(t))continue;string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY SELL STOP")<0&&StringFind(c,"RECOVERY BUY STOP")<0&&StringFind(c,"RECOVERY 1")<0)continue;
      if(!trade.OrderDelete(t))PrintFormat("Recovery pending delete failed #%I64u ret=%u",t,trade.ResultRetcode());}
}

void ManageRecoveryPending(){
   UpdateStatus();if(Recovery1Active||Recovery2Active||!EnableRecoveryPending||!IsTradingHour())return;
   ENUM_POSITION_TYPE primary=WRONG_VALUE;double pl=0,lots=0;
   if(BuyOrders>=3&&SellOrders==0){primary=POSITION_TYPE_BUY;pl=BuyProfits;lots=BuyLots;}
   else if(SellOrders>=3&&BuyOrders==0){primary=POSITION_TYPE_SELL;pl=SellProfits;lots=SellLots;}
   else{if(BuyOrders<3&&SellOrders<3)DeleteRecoveryPendings();return;}
   if(pl>=0)return;
   if(HasRecoveryPending())return;
   PlaceRecoveryPending(primary,lots);
}

bool PlaceRecoveryPending(ENUM_POSITION_TYPE primary,double primaryLots){
   double vol=NormalizeVolume(primaryLots*RecoveryMultiplier);if(MaxRecoveryLot>0&&vol>MaxRecoveryLot)vol=NormalizeVolume(MaxRecoveryLot);if(vol<=0)return false;
   double gp=RecoveryGapPoints>0?RecoveryGapPoints:PointsForFirstGap,gap=gp*_Point;int d=(int)SymbolInfoInteger(SymbolTrade,SYMBOL_DIGITS);ENUM_ORDER_TYPE ot;double price;string c;
   if(primary==POSITION_TYPE_BUY){ot=ORDER_TYPE_SELL_STOP;price=NormalizeDouble(SymbolInfoDouble(SymbolTrade,SYMBOL_BID)-gap,d);c="GRID 06 V07 RECOVERY SELL STOP";}
   else{ot=ORDER_TYPE_BUY_STOP;price=NormalizeDouble(SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)+gap,d);c="GRID 06 V07 RECOVERY BUY STOP";}
   double md=(double)SymbolInfoInteger(SymbolTrade,SYMBOL_TRADE_STOPS_LEVEL)*_Point;
   if(ot==ORDER_TYPE_SELL_STOP){double x=SymbolInfoDouble(SymbolTrade,SYMBOL_BID)-md;if(price>x)price=NormalizeDouble(x,d);}
   else{double x=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)+md;if(price<x)price=NormalizeDouble(x,d);}
   trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok;
   if(ot==ORDER_TYPE_SELL_STOP)ok=trade.SellStop(vol,price,SymbolTrade,0,0,ORDER_TIME_GTC,0,c);else ok=trade.BuyStop(vol,price,SymbolTrade,0,0,ORDER_TIME_GTC,0,c);
   if(!ok||!TradeOK()){PrintFormat("Recovery 1 failed vol=%.2f price=%.3f ret=%u %s",vol,price,trade.ResultRetcode(),trade.ResultRetcodeDescription());return false;}
   return true;
}

void ManageRecovery2(){
   if(!EnableRecovery2||!IsTradingHour())return;UpdateStatus();
   if(!Recovery1Active||Recovery2Active||Buy3Price<=0)return;
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);if(ask<Buy3Price)return;
   double total=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;
   if(Recovery2OnlyIfBasketNegative&&total>=0)return;
   if(Recovery1Profit>=0)return;
   double vol=NormalizeVolume(Recovery2Lot);if(vol<=0)return;
   trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);
   bool ok=trade.Buy(vol,SymbolTrade,0,0,0,"GRID 06 V07 RECOVERY 2 BUY");
   if(!ok||!TradeOK()){PrintFormat("Recovery 2 failed vol=%.2f trigger=%.3f ret=%u %s",vol,Buy3Price,trade.ResultRetcode(),trade.ResultRetcodeDescription());return;}
   PrintFormat("Recovery 2 BUY %.2f opened after price crossed BUY 3 %.3f",vol,Buy3Price);
}

bool ExecutePrimary(ENUM_ORDER_TYPE type){
   int c=type==ORDER_TYPE_BUY?BuyOrders:SellOrders;if(c>=MaxOrders)return false;double v=NormalizeVolume(ManualLotSize*(c+1));if(v<=0)return false;
   trade.SetExpertMagicNumber(OrdersID);trade.SetTypeFillingBySymbol(SymbolTrade);bool ok;
   if(type==ORDER_TYPE_BUY)ok=trade.Buy(v,SymbolTrade,0,0,0,StringFormat("GRID 06 V07 PRIMARY BUY %d",c+1));
   else ok=trade.Sell(v,SymbolTrade,0,0,0,StringFormat("GRID 06 V07 PRIMARY SELL %d",c+1));
   if(!ok||!TradeOK()){PrintFormat("Primary failed %s ret=%u %s",EnumToString(type),trade.ResultRetcode(),trade.ResultRetcodeDescription());return false;}return true;
}

void ManageCombinedBasketExit(){
   UpdateStatus();double p=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;
   if(BuyOrders+SellOrders==0&&!Recovery1Active&&!Recovery2Active){BasketPeakProfit=0;return;}
   if(p>=TargetProfitUSD){DeleteRecoveryPendings();CloseAllOrders();BasketPeakProfit=0;return;}
   if(UseTrailingProfit&&p>=TrailingStartUSD){if(p>BasketPeakProfit)BasketPeakProfit=p;if(BasketPeakProfit>0&&p<=BasketPeakProfit-TrailingStopUSD){DeleteRecoveryPendings();CloseAllOrders();BasketPeakProfit=0;}}
}
void CloseAllOrders(){for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(!IsOurPosition(t))continue;if(!trade.PositionClose(t))PrintFormat("Close failed #%I64u ret=%u %s",t,trade.ResultRetcode(),trade.ResultRetcodeDescription());}}
double GetRSI(){double b[];ArraySetAsSeries(b,true);return CopyBuffer(HandleRSI,0,0,1,b)>0?b[0]:50.0;}
double GetMA(){double b[];ArraySetAsSeries(b,true);return CopyBuffer(HandleMA,0,0,1,b)>0?b[0]:0.0;}
void DisplayDashboard(double dd){
   double p=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;string st=Recovery2Active?"RECOVERY 2 ACTIVE":(Recovery1Active?"RECOVERY 1 ACTIVE":(HasRecoveryPending()?"RECOVERY 1 PENDING":((BuyOrders+SellOrders)>0?"PRIMARY BASKET":"IDLE")));
   Comment("===== GRID 06 V07 =====\nState: ",st,"\nDD: ",DoubleToString(dd,2),"%\nPRIMARY BUY: ",BuyOrders," / ",DoubleToString(BuyLots,2)," / ",DoubleToString(BuyProfits,2),"\nPRIMARY SELL: ",SellOrders," / ",DoubleToString(SellLots,2)," / ",DoubleToString(SellProfits,2),"\nBUY 3 PRICE: ",DoubleToString(Buy3Price,_Digits),"\nRECOVERY 1: ",DoubleToString(Recovery1Lots,2)," / ",DoubleToString(Recovery1Profit,2),"\nRECOVERY 2: ",DoubleToString(Recovery2Lots,2)," / ",DoubleToString(Recovery2Profit,2),"\nBASKET: ",DoubleToString(p,2)," USD\nRECOVERY GAP: ",DoubleToString(RecoveryGapPoints,0)," points\nRECOVERY 2 LOT: ",DoubleToString(Recovery2Lot,2),"\nTARGET: ",DoubleToString(TargetProfitUSD,2)," USD");
}
