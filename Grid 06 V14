//+------------------------------------------------------------------+
//| GRID 06.V14 - HYBRID RECOVERY EDITION                           |
//| V12 recovery mechanics + V13 session/risk architecture          |
//|                                                                  |
//| RECOVERY DESIGN                                                  |
//| R1 = opposite hedge after primary basket reaches R1 gap         |
//| R2 = original primary direction after R2 gap                    |
//| R2 uses V12 30x sizing, capped at 1.80 lots                     |
//| No M5 confirmation: preserve the proven V12 trigger              |
//|                                                                  |
//| IMPORTANT SESSION RULE                                           |
//| Primary trading is restricted to StartHour-EndHour.              |
//| If a recovery basket is already active, it is NOT force-closed   |
//| at EndHour. R1/R2 may finish outside the primary session.        |
//| No new primary basket is allowed outside the session.            |
//|                                                                  |
//| No R3. Primary/R1/R2 are managed as ONE basket.                 |
//+------------------------------------------------------------------+
#property strict
#property version "14.00"

#include <Trade/Trade.mqh>
CTrade trade;

enum Type {Open_Buy_And_Sell,Open__Only_Buy,Open__Only_Sell};

//================ BASKET =================//
input double TargetProfitUSD        = 5.0;
input bool   UseTrailingProfit      = true;
input double TrailingStartUSD      = 5.0;
input double TrailingStopUSD       = 2.0;

//================ RISK =================//
input double MaxEquityLossPercent  = 15.0;

//================ PRIMARY =================//
input int    MAPeriod              = 200;
input int    RSIPeriod             = 14;
input int    RSIUpper              = 61;
input int    RSILower              = 41;
input Type   TypeOrdersPlace       = Open_Buy_And_Sell;
input double PointsForFirstGap     = 6250.0;
input double GapMultiplier         = 1.30;
input double ManualLotSize         = 0.01;
input int    MaxOrders             = 3;

//================ STAGE 1 RECOVERY =================//
// V12-proven gap: 10000 points.
input bool   EnableRecovery        = true;
input double Recovery1Multiplier   = 10.0;
input double Recovery1GapPoints    = 10000.0;
input double Recovery1MaxLot       = 0.60;

//================ STAGE 2 RECOVERY =================//
// V12-proven gap: 6250 points.
// V12-proven sizing: R1 lot x 30, capped at 1.80 lots.
input bool   EnableRecovery2        = true;
input double Recovery2Multiplier    = 30.0;
input double Recovery2GapPoints     = 6250.0;
input double Recovery2MaxLot        = 1.80;

// Optional protection. Disabled by default so the V12 recovery behavior
// is preserved. Global MaxEquityLossPercent remains the final hard stop.
input bool   UseRecovery2HardSL     = false;
input double Recovery2StopPoints    = 2500.0;
input int    Recovery2MaxHoldMinutes= 0;

//================ GENERAL RECOVERY =================//
input bool   RecoveryOnlyWhenMinus  = true;
input int    MaxRecoveryStages      = 2;

//================ HOURS =================//
input bool   UseTradingHour         = true;
input int    StartHour              = 7;
input int    EndHour                = 22;

//================ ENGINE =================//
input int    MagicNumber            = 16082016;
input string CommentsOrders         = "GRID 06 V14";

string SymbolTrade;
int OrdersID,HandleRSI,HandleMA;

int BuyOrders=0,SellOrders=0;
double BuyLots=0,SellLots=0;
double BuyProfit=0,SellProfit=0;
double LastBuyPrice=0,LastSellPrice=0;
double Buy3Price=0,Sell3Price=0;
datetime LastBuyTime=0,LastSellTime=0;

int RecoveryStage=0;
double Recovery1Lots=0,Recovery1Profit=0,Recovery1EntryPrice=0;
double Recovery2Lots=0,Recovery2Profit=0,Recovery2EntryPrice=0;
datetime Recovery2EntryTime=0;
ENUM_POSITION_TYPE Recovery1Type=WRONG_VALUE;
ENUM_POSITION_TYPE Recovery2Type=WRONG_VALUE;

double RecoveryLots=0,RecoveryProfit=0;
bool RecoveryActive=false;

double BasketProfitValue=0;
double BasketPeakProfit=0;
bool BasketTrailingActive=false;
bool IsTerminated=false;
bool R2Used=false;
string R2GVName="";

//+------------------------------------------------------------------+
//| FUNCTION: IsTradingHour                                         |
//+------------------------------------------------------------------+
bool IsTradingHour(){
   if(!UseTradingHour) return true;
   MqlDateTime dt; TimeToStruct(TimeCurrent(),dt);
   if(StartHour<EndHour) return dt.hour>=StartHour && dt.hour<EndHour;
   return dt.hour>=StartHour || dt.hour<EndHour;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsOurPosition                                         |
//+------------------------------------------------------------------+
bool IsOurPosition(ulong ticket){
   if(ticket==0 || !PositionSelectByTicket(ticket)) return false;
   return PositionGetInteger(POSITION_MAGIC)==OrdersID &&
          PositionGetString(POSITION_SYMBOL)==SymbolTrade;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsOurOrder                                            |
//+------------------------------------------------------------------+
bool IsOurOrder(ulong ticket){
   if(ticket==0 || !OrderSelect(ticket)) return false;
   return OrderGetInteger(ORDER_MAGIC)==OrdersID &&
          OrderGetString(ORDER_SYMBOL)==SymbolTrade;
}

//+------------------------------------------------------------------+
//| FUNCTION: TradeOK                                               |
//+------------------------------------------------------------------+
bool TradeOK(){
   uint r=trade.ResultRetcode();
   return r==TRADE_RETCODE_DONE ||
          r==TRADE_RETCODE_DONE_PARTIAL ||
          r==TRADE_RETCODE_PLACED;
}

//+------------------------------------------------------------------+
//| FUNCTION: NormalizeVolume                                       |
//+------------------------------------------------------------------+
double NormalizeVolume(double v){
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);
   if(mn<=0) mn=0.01;
   if(st<=0) st=0.01;
   if(mx<=0) mx=v;
   v=MathMax(mn,MathMin(mx,v));
   v=MathFloor((v+1e-12)/st)*st;
   v=MathMax(mn,MathMin(mx,v));
   int digits=2;
   if(st<0.01) digits=3;
   if(st<0.001) digits=4;
   return NormalizeDouble(v,digits);
}

//+------------------------------------------------------------------+
//| FUNCTION: GetPoint                                              |
//+------------------------------------------------------------------+
double GetPoint(){
   double p=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);
   return p>0 ? p : _Point;
}

//+------------------------------------------------------------------+
//| FUNCTION: GetRSI                                                |
//+------------------------------------------------------------------+
double GetRSI(){
   double b[]; ArraySetAsSeries(b,true);
   return CopyBuffer(HandleRSI,0,0,1,b)>0 ? b[0] : 50.0;
}

//+------------------------------------------------------------------+
//| FUNCTION: GetMA                                                 |
//+------------------------------------------------------------------+
double GetMA(int shift=0){
   double b[]; ArraySetAsSeries(b,true);
   return CopyBuffer(HandleMA,0,shift,1,b)>0 ? b[0] : 0.0;
}

//+------------------------------------------------------------------+
//| FUNCTION: ResetRecoveryState                                    |
//+------------------------------------------------------------------+
void ResetRecoveryState(){
   RecoveryStage=0;
   Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0;
   Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0;
   Recovery2EntryTime=0;
   Recovery1Type=WRONG_VALUE;
   Recovery2Type=WRONG_VALUE;
   RecoveryLots=RecoveryProfit=0;
   RecoveryActive=false;
   BasketPeakProfit=0;
   BasketTrailingActive=false;
   R2Used=false;
   if(R2GVName!="") GlobalVariableSet(R2GVName,0.0);
}

//+------------------------------------------------------------------+
//| FUNCTION: OnInit                                                |
//+------------------------------------------------------------------+
int OnInit(){
   SymbolTrade=_Symbol;
   OrdersID=(MagicNumber==0)?101010:MagicNumber;

   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE);
   HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   if(HandleRSI==INVALID_HANDLE || HandleMA==INVALID_HANDLE)
      return INIT_FAILED;
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
      return INIT_FAILED;

   R2GVName="GRID6V14_R2USED_"+SymbolTrade+"_"+IntegerToString(OrdersID);
   if(GlobalVariableCheck(R2GVName))
      R2Used=(GlobalVariableGet(R2GVName)>0.5);
   else
      GlobalVariableSet(R2GVName,0.0);

   UpdateStatus();
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| FUNCTION: OnDeinit                                              |
//+------------------------------------------------------------------+
void OnDeinit(const int reason){
   IndicatorRelease(HandleRSI);
   IndicatorRelease(HandleMA);
   Comment("");
}

//+------------------------------------------------------------------+
//| FUNCTION: OnTick                                                |
//+------------------------------------------------------------------+
void OnTick(){
   if(IsTerminated || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return;

   UpdateStatus();

   if(BuyOrders==0 && SellOrders==0 && RecoveryStage==0 && R2Used)
      ResetRecoveryState();

   double balance=AccountInfoDouble(ACCOUNT_BALANCE);
   double equity=AccountInfoDouble(ACCOUNT_EQUITY);
   double dd=(equity<balance && balance>0.0)
             ?(balance-equity)/balance*100.0
             :0.0;

   if(dd>=MaxEquityLossPercent){
      DeleteRecoveryPending();
      CloseAllExposure();
      IsTerminated=true;
      DisplayDashboard(dd);
      return;
   }

   // Basket exit is evaluated BEFORE the session rule so an active
   // recovery basket can finish normally even after EndHour.
   ManageBasketExit();
   UpdateStatus();

   //==============================================================
   // SESSION ENGINE
   //==============================================================
   // During the primary session: normal operation.
   // Outside the primary session:
   //   - no new primary entries
   //   - no pending recovery orders
   //   - ACTIVE recovery positions are allowed to finish
   //     instead of being hard-closed at EndHour.
   if(UseTradingHour && !IsTradingHour()){
      DeleteRecoveryPending();

      if(RecoveryActive){
         // Recovery is already in progress: let it complete.
         if(RecoveryStage==1)
            ManageRecoveryStage2();
         ManageR2Risk();
         ManageBasketExit();
      }
      else{
         // No recovery: primary exposure must not survive the session.
         CloseAllExposure();
      }

      UpdateStatus();
      DisplayDashboard(dd);
      return;
   }

   //==============================================================
   // RECOVERY ENGINE
   //==============================================================
   if(RecoveryActive){
      if(RecoveryStage==1)
         ManageRecoveryStage2();
      ManageR2Risk();
      DisplayDashboard(dd);
      return;
   }

   //==============================================================
   // PRIMARY -> R1
   //==============================================================
   if(BuyOrders>=MaxOrders && SellOrders==0){
      ManageRecoveryStage1(POSITION_TYPE_BUY);
      DisplayDashboard(dd);
      return;
   }

   if(SellOrders>=MaxOrders && BuyOrders==0){
      ManageRecoveryStage1(POSITION_TYPE_SELL);
      DisplayDashboard(dd);
      return;
   }

   ManagePrimaryGrid();
   DisplayDashboard(dd);
}

//+------------------------------------------------------------------+
//| FUNCTION: UpdateStatus                                          |
//+------------------------------------------------------------------+
void UpdateStatus(){
   BuyOrders=SellOrders=0;
   BuyLots=SellLots=0;
   BuyProfit=SellProfit=0;
   LastBuyPrice=LastSellPrice=0;
   Buy3Price=Sell3Price=0;
   LastBuyTime=LastSellTime=0;

   RecoveryStage=0;
   Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0;
   Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0;
   Recovery2EntryTime=0;
   Recovery1Type=WRONG_VALUE;
   Recovery2Type=WRONG_VALUE;

   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i);
      if(!IsOurPosition(ticket)) continue;

      ENUM_POSITION_TYPE type=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double lot=PositionGetDouble(POSITION_VOLUME);
      double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      double open=PositionGetDouble(POSITION_PRICE_OPEN);
      datetime tm=(datetime)PositionGetInteger(POSITION_TIME);
      string c=PositionGetString(POSITION_COMMENT);

      bool r1=(StringFind(c,"RECOVERY 1 BUY")>=0 || StringFind(c,"RECOVERY 1 SELL")>=0);
      bool r2=(StringFind(c,"RECOVERY 2 BUY")>=0 || StringFind(c,"RECOVERY 2 SELL")>=0);

      if(r1){
         Recovery1Lots+=lot;
         Recovery1Profit+=p;
         Recovery1EntryPrice=open;
         Recovery1Type=type;
         RecoveryStage=MathMax(RecoveryStage,1);
         continue;
      }

      if(r2){
         Recovery2Lots+=lot;
         Recovery2Profit+=p;
         Recovery2EntryPrice=open;
         Recovery2EntryTime=tm;
         Recovery2Type=type;
         RecoveryStage=MathMax(RecoveryStage,2);
         continue;
      }

      if(type==POSITION_TYPE_BUY){
         BuyOrders++;
         BuyLots+=lot;
         BuyProfit+=p;
         if(tm>=LastBuyTime){
            LastBuyTime=tm;
            LastBuyPrice=open;
         }
         if(StringFind(c,"PRIMARY BUY 3")>=0) Buy3Price=open;
      }
      else if(type==POSITION_TYPE_SELL){
         SellOrders++;
         SellLots+=lot;
         SellProfit+=p;
         if(tm>=LastSellTime){
            LastSellTime=tm;
            LastSellPrice=open;
         }
         if(StringFind(c,"PRIMARY SELL 3")>=0) Sell3Price=open;
      }
   }

   RecoveryLots=Recovery1Lots+Recovery2Lots;
   RecoveryProfit=Recovery1Profit+Recovery2Profit;
   RecoveryActive=(RecoveryStage>0);
   BasketProfitValue=BuyProfit+SellProfit+RecoveryProfit;
}

//+------------------------------------------------------------------+
//| FUNCTION: HasRecoveryPending                                    |
//+------------------------------------------------------------------+
bool HasRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i);
      if(!IsOurOrder(ticket)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY 1 BUY")>=0 || StringFind(c,"RECOVERY 1 SELL")>=0 ||
         StringFind(c,"RECOVERY 2 BUY")>=0 || StringFind(c,"RECOVERY 2 SELL")>=0)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| FUNCTION: DeleteRecoveryPending                                 |
//+------------------------------------------------------------------+
void DeleteRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i);
      if(!IsOurOrder(ticket)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY 1 BUY")<0 && StringFind(c,"RECOVERY 1 SELL")<0 &&
         StringFind(c,"RECOVERY 2 BUY")<0 && StringFind(c,"RECOVERY 2 SELL")<0)
         continue;
      trade.OrderDelete(ticket);
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageRecoveryStage1                                  |
//+------------------------------------------------------------------+
void ManageRecoveryStage1(ENUM_POSITION_TYPE primaryType){
   if(!EnableRecovery || RecoveryStage>0 || HasRecoveryPending()) return;
   if(MaxRecoveryStages<1) return;

   double primaryPL=(primaryType==POSITION_TYPE_BUY)?BuyProfit:SellProfit;
   double primaryLots=(primaryType==POSITION_TYPE_BUY)?BuyLots:SellLots;
   double thirdPrice=(primaryType==POSITION_TYPE_BUY)?Buy3Price:Sell3Price;

   if(RecoveryOnlyWhenMinus && primaryPL>=0.0) return;
   if(primaryLots<=0.0 || thirdPrice<=0.0) return;

   double point=GetPoint();
   double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);

   double adversePoints=(primaryType==POSITION_TYPE_BUY)
                        ?(thirdPrice-bid)/point
                        :(ask-thirdPrice)/point;

   if(adversePoints<Recovery1GapPoints) return;

   UpdateStatus();
   if(RecoveryOnlyWhenMinus && BasketProfitValue>=0.0) return;

   double lot=NormalizeVolume(primaryLots*Recovery1Multiplier);
   if(Recovery1MaxLot>0.0)
      lot=NormalizeVolume(MathMin(lot,Recovery1MaxLot));
   if(lot<=0.0) return;

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=false;
   string c;

   if(primaryType==POSITION_TYPE_BUY){
      c=CommentsOrders+" RECOVERY 1 SELL";
      ok=trade.Sell(lot,SymbolTrade,0,0,0,c);
   }
   else{
      c=CommentsOrders+" RECOVERY 1 BUY";
      ok=trade.Buy(lot,SymbolTrade,0,0,0,c);
   }

   if(ok && TradeOK())
      PrintFormat("V14 R1 OPEN | primary=%s | basket=%.2f | primaryLots=%.2f | R1Lot=%.2f | gap=%.0f",
                  primaryType==POSITION_TYPE_BUY?"BUY":"SELL",
                  BasketProfitValue,primaryLots,lot,adversePoints);
   else
      PrintFormat("V14 R1 FAILED | basket=%.2f | lot=%.2f | retcode=%u | %s",
                  BasketProfitValue,lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
//| FUNCTION: CalculateRecovery2Lot                                |
//+------------------------------------------------------------------+
double CalculateRecovery2Lot(){
   if(Recovery1Lots<=0.0) return 0.0;

   double lot=Recovery1Lots*Recovery2Multiplier;
   if(Recovery2MaxLot>0.0)
      lot=MathMin(lot,Recovery2MaxLot);

   return NormalizeVolume(lot);
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageRecoveryStage2                                  |
//+------------------------------------------------------------------+
void ManageRecoveryStage2(){
   if(!EnableRecovery2 || !EnableRecovery) return;
   if(MaxRecoveryStages<2 || RecoveryStage!=1 || R2Used) return;
   if(Recovery1Lots<=0.0 || Recovery1EntryPrice<=0.0) return;
   if(Recovery1Profit>=0.0) return;

   UpdateStatus();
   if(RecoveryStage!=1 || Recovery1Profit>=0.0) return;
   if(RecoveryOnlyWhenMinus && BasketProfitValue>=0.0) return;

   double point=GetPoint();
   double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);

   double adversePoints=0.0;
   if(Recovery1Type==POSITION_TYPE_BUY)
      adversePoints=(Recovery1EntryPrice-bid)/point;
   else if(Recovery1Type==POSITION_TYPE_SELL)
      adversePoints=(ask-Recovery1EntryPrice)/point;
   else
      return;

   if(adversePoints<Recovery2GapPoints) return;

   // R2 returns to the ORIGINAL primary direction.
   ENUM_POSITION_TYPE primaryType=(Recovery1Type==POSITION_TYPE_SELL)
                                  ?POSITION_TYPE_BUY
                                  :POSITION_TYPE_SELL;

   double lot=CalculateRecovery2Lot();
   if(lot<=0.0) return;

   double entry=(primaryType==POSITION_TYPE_BUY)
                ?SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)
                :SymbolInfoDouble(SymbolTrade,SYMBOL_BID);

   double sl=0.0;
   if(UseRecovery2HardSL && Recovery2StopPoints>0.0){
      double pointDistance=Recovery2StopPoints*point;
      long stopsLevel=(long)SymbolInfoInteger(SymbolTrade,SYMBOL_TRADE_STOPS_LEVEL);
      double effectivePoints=MathMax(Recovery2StopPoints,(double)stopsLevel);
      pointDistance=effectivePoints*point;

      sl=(primaryType==POSITION_TYPE_BUY)
         ?entry-pointDistance
         :entry+pointDistance;

      int digits=(int)SymbolInfoInteger(SymbolTrade,SYMBOL_DIGITS);
      sl=NormalizeDouble(sl,digits);
   }

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=false;
   string c;

   if(primaryType==POSITION_TYPE_BUY){
      c=CommentsOrders+" RECOVERY 2 BUY";
      ok=trade.Buy(lot,SymbolTrade,0,sl,0,c);
   }
   else{
      c=CommentsOrders+" RECOVERY 2 SELL";
      ok=trade.Sell(lot,SymbolTrade,0,sl,0,c);
   }

   if(ok && TradeOK()){
      R2Used=true;
      if(R2GVName!="") GlobalVariableSet(R2GVName,1.0);
      PrintFormat("V14 R2 OPEN | primary=%s | basket=%.2f | R1Lot=%.2f | R2Lot=%.2f | gap=%.0f | SL=%s",
                  primaryType==POSITION_TYPE_BUY?"BUY":"SELL",
                  BasketProfitValue,Recovery1Lots,lot,adversePoints,
                  UseRecovery2HardSL?DoubleToString(sl,(int)SymbolInfoInteger(SymbolTrade,SYMBOL_DIGITS)):"OFF");
   }
   else{
      PrintFormat("V14 R2 FAILED | primary=%s | lot=%.2f | retcode=%u | %s",
                  primaryType==POSITION_TYPE_BUY?"BUY":"SELL",
                  lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageR2Risk                                          |
//+------------------------------------------------------------------+
void ManageR2Risk(){
   if(RecoveryStage!=2) return;

   if(Recovery2EntryTime>0 && Recovery2MaxHoldMinutes>0){
      int age=(int)(TimeCurrent()-Recovery2EntryTime);
      if(age>=Recovery2MaxHoldMinutes*60){
         PrintFormat("V14 R2 TIME STOP | age=%d min | profit=%.2f",age/60,Recovery2Profit);
         CloseRecovery2Only();
         return;
      }
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: CloseRecovery2Only                                    |
//+------------------------------------------------------------------+
void CloseRecovery2Only(){
   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i);
      if(!IsOurPosition(ticket)) continue;
      string c=PositionGetString(POSITION_COMMENT);
      if(StringFind(c,"RECOVERY 2 BUY")<0 && StringFind(c,"RECOVERY 2 SELL")<0)
         continue;
      trade.PositionClose(ticket);
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ManagePrimaryGrid                                     |
//+------------------------------------------------------------------+
void ManagePrimaryGrid(){
   UpdateStatus();
   if(BuyOrders>0 && SellOrders>0) return;

   double point=GetPoint();

   if(BuyOrders>0 && BuyOrders<MaxOrders){
      double gap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1)*point;
      if(SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)<=LastBuyPrice-gap)
         ExecutePrimary(ORDER_TYPE_BUY);
      return;
   }

   if(SellOrders>0 && SellOrders<MaxOrders){
      double gap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1)*point;
      if(SymbolInfoDouble(SymbolTrade,SYMBOL_BID)>=LastSellPrice+gap)
         ExecutePrimary(ORDER_TYPE_SELL);
      return;
   }

   if(BuyOrders==0 && SellOrders==0){
      double r=GetRSI();
      double ma=GetMA(0);
      double price=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);

      if(TypeOrdersPlace!=Open__Only_Sell && ma>0.0 && price>ma && r<RSILower){
         ExecutePrimary(ORDER_TYPE_BUY);
         return;
      }

      if(TypeOrdersPlace!=Open__Only_Buy && ma>0.0 && price<ma && r>RSIUpper){
         ExecutePrimary(ORDER_TYPE_SELL);
         return;
      }
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ExecutePrimary                                        |
//+------------------------------------------------------------------+
bool ExecutePrimary(ENUM_ORDER_TYPE type){
   UpdateStatus();

   int next=(type==ORDER_TYPE_BUY)?BuyOrders+1:SellOrders+1;
   if(next<1 || next>MaxOrders) return false;

   double lot=NormalizeVolume(ManualLotSize*next);
   if(lot<=0.0) return false;

   string c=CommentsOrders+
            (type==ORDER_TYPE_BUY?" PRIMARY BUY ":" PRIMARY SELL ")+
            IntegerToString(next);

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=(type==ORDER_TYPE_BUY)
           ?trade.Buy(lot,SymbolTrade,0,0,0,c)
           :trade.Sell(lot,SymbolTrade,0,0,0,c);

   if(ok && TradeOK()){
      PrintFormat("V14 PRIMARY OPEN | type=%s | order=%d | lot=%.2f",
                  type==ORDER_TYPE_BUY?"BUY":"SELL",next,lot);
      return true;
   }

   PrintFormat("V14 PRIMARY FAILED | type=%s | order=%d | lot=%.2f | retcode=%u | %s",
               type==ORDER_TYPE_BUY?"BUY":"SELL",next,lot,
               trade.ResultRetcode(),trade.ResultRetcodeDescription());
   return false;
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageBasketExit                                      |
//+------------------------------------------------------------------+
void ManageBasketExit(){
   UpdateStatus();

   if(BuyOrders==0 && SellOrders==0 && RecoveryStage==0){
      BasketPeakProfit=0.0;
      BasketTrailingActive=false;
      return;
   }

   double p=BasketProfitValue;
   if(p>BasketPeakProfit) BasketPeakProfit=p;

   if(TargetProfitUSD>0.0 && p>=TargetProfitUSD){
      PrintFormat("V14 BASKET TARGET | profit=%.2f",p);
      CloseBasket();
      return;
   }

   if(UseTrailingProfit && TrailingStartUSD>0.0 && p>=TrailingStartUSD){
      BasketTrailingActive=true;
      double floor=BasketPeakProfit-TrailingStopUSD;
      if(floor>0.0 && p<=floor){
         PrintFormat("V14 BASKET TRAIL | peak=%.2f | current=%.2f | floor=%.2f",
                     BasketPeakProfit,p,floor);
         CloseBasket();
         return;
      }
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: CloseBasket                                           |
//+------------------------------------------------------------------+
void CloseBasket(){
   DeleteRecoveryPending();

   for(int pass=0;pass<3;pass++){
      bool any=false;
      for(int i=PositionsTotal()-1;i>=0;i--){
         ulong ticket=PositionGetTicket(i);
         if(!IsOurPosition(ticket)) continue;
         any=true;
         trade.PositionClose(ticket);
      }
      if(!any) break;
   }

   UpdateStatus();
   if(BuyOrders==0 && SellOrders==0 && RecoveryStage==0)
      ResetRecoveryState();
}

