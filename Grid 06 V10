void DisplayDashboard(double dd)
{
   double p=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;

   string st="IDLE";

   if(Recovery2Active) st="RECOVERY 2 BOOSTER";
   else if(Recovery1Active) st="RECOVERY 1 ACTIVE";
   else if(HasRecoveryPending()) st="RECOVERY ARMED";
   else if((BuyOrders+SellOrders)>0) st="PRIMARY BASKET";

   Comment(
      "===== GRID 06 V10 =====\n",
      "State: ",st,"\n",
      "DD: ",DoubleToString(dd,2),"%\n",
      "Basket P/L: ",DoubleToString(p,2),"\n",
      "PRIMARY BUY: ",BuyOrders," / ",DoubleToString(BuyLots,2),
      " / ",DoubleToString(BuyProfits,2),"\n",
      "PRIMARY SELL: ",SellOrders," / ",DoubleToString(SellLots,2),
      " / ",DoubleToString(SellProfits,2),"\n",
      "RECOVERY 1: ",Recovery1Active?"ACTIVE":"OFF",
      " / ",DoubleToString(Recovery1Lots,2),
      " / ",DoubleToString(Recovery1Profit,2),"\n",
      "RECOVERY 2: ",Recovery2Active?"ACTIVE":"OFF",
      " / ",DoubleToString(Recovery2Lots,2),
      " / ",DoubleToString(Recovery2Profit,2),"\n",
      "ADX: ",DoubleToString(GetADX(),1),
      " | RSI: ",DoubleToString(GetRSI(),1),"\n",
      "Target: ",DoubleToString(TargetProfitUSD,2),
      " | Trail: ",DoubleToString(TrailingStartUSD,2),
      "/",DoubleToString(TrailingStopUSD,2),"\n",
      "R1 coverage: ",DoubleToString(RecoveryCoveragePercent,0),
      "% | MaxLot: ",DoubleToString(RecoveryMaxLot,2),
      " | MaxR1Loss: ",DoubleToString(RecoveryMaxLossUSD,2)
   );
}
