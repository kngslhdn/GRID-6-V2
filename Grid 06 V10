double GetRSI()
{
   double b[];
   ArraySetAsSeries(b,true);
   return CopyBuffer(HandleRSI,0,0,1,b)>0?b[0]:50.0;
}

double GetMA(int shift)
{
   double b[];
   ArraySetAsSeries(b,true);
   return CopyBuffer(HandleMA,0,shift,1,b)>0?b[0]:0.0;
}

double GetADX()
{
   double b[];
   ArraySetAsSeries(b,true);
   return CopyBuffer(HandleADX,0,0,1,b)>0?b[0]:0.0;
}

