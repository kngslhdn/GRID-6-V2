//+------------------------------------------------------------------+
//| GRID 06.V09 - RECOVERY HANDOFF                                  |
//+------------------------------------------------------------------+
#property strict
#property version "9.00"
#include <Trade/Trade.mqh>
CTrade trade;
enum Type {Open_Buy_And_Sell,Open__Only_Buy,Open__Only_Sell};

input double MaxEquityLossPercent=15.0;
input bool UseTrailingProfit=true;
input double TrailingStartUSD=5.0;
input double TrailingStopUSD=2.0;
input double TargetProfitUSD=5.0;

input int MAPeriod=200;
input int RSIPeriod=14;
input int RSIUpper=61;
input int RSILower=41;
input Type TypeOrdersPlace=Open_Buy_And_Sell;

input double PointsForFirstGap=6250.0;
input double GapMultiplier=1.30;
input double ManualLotSize=0.01;
input int MaxOrders=3;

input int MagicNumber=16082016;
input string CommentsOrders="GRID 06 V09";

input bool EnableRecoveryPending=true;
input double RecoveryMultiplier=1.50;
input int RecoveryTriggerOrders=3;
input double RecoveryGapPoints=6250.0;
input double MaxRecoveryLot=0.0;

input bool EnableRecovery2=true;
input double Recovery2Lot=0.03;
input double Recovery2MinLot=0.01;
input double Recovery2MaxLot=0.03;
input double Recovery2ConfirmPoints=3000.0;
input bool Recovery2OnlyIfBasketNegative=true;

input bool UseTradingHour=true;
input int StartHour=7;
input int EndHour=22;

string SymbolTrade;
int OrdersID,HandleRSI,HandleMA;
int BuyOrders,SellOrders;
double BuyProfits,SellProfits,BuyLots,SellLots;
double PriceOpenLastBuy,PriceOpenLastSell;
double Buy1Price,Sell1Price,Buy3Price,Sell3Price;
double Recovery1Profit,Recovery1Lots,Recovery2Profit,Recovery2Lots;
bool Recovery1Active=false,Recovery2Active=false,IsTerminated=false;
double HighWaterMark=0,InitialBalance=0,AdaptiveEquityBase=0,BasketPeakProfit=0;

bool IsTradingHour()
{
   if(!UseTradingHour) return true;
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(),dt);
   if(StartHour<EndHour) return dt.hour>=StartHour && dt.hour<EndHour;
   return dt.hour>=StartHour || dt.hour<EndHour;
}

bool IsOurPosition(ulong t)
{
   if(t==0 || !PositionSelectByTicket(t)) return false;
   return PositionGetInteger(POSITION_MAGIC)==OrdersID && PositionGetString(POSITION_SYMBOL)==SymbolTrade;
}

bool IsOurOrder(ulong t)
{
   if(t==0 || !OrderSelect(t)) return false;
   return OrderGetInteger(ORDER_MAGIC)==OrdersID && OrderGetString(ORDER_SYMBOL)==SymbolTrade;
}

bool TradeOK()
{
   uint r=trade.ResultRetcode();
   return r==TRADE_RETCODE_DONE || r==TRADE_RETCODE_DONE_PARTIAL || r==TRADE_RETCODE_PLACED;
}

double NormalizeVolume(double v)
{
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);
   if(mn<=0) mn=0.01;
   if(st<=0) st=mn;
   if(mx<=0) mx=v;
   v=MathMax(mn,MathMin(mx,v));
   v=MathFloor(v/st+1e-9)*st;
   if(v<mn) v=mn;
   int d=(st<0.01)?3:2;
   if(st<0.001) d=4;
   return NormalizeDouble(v,d);
}

int OnInit()
{
   SymbolTrade=_Symbol;
   OrdersID=(MagicNumber==0)?101010:MagicNumber;
   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE);
   HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);
   InitialBalance=AccountInfoDouble(ACCOUNT_BALANCE);
   AdaptiveEquityBase=InitialBalance;
   HighWaterMark=InitialBalance;
   trade.SetExpertMagicNumber(OrdersID);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFillingBySymbol(SymbolTrade);
   if(HandleRSI==INVALID_HANDLE || HandleMA==INVALID_HANDLE) return INIT_FAILED;
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING) return INIT_FAILED;
   UpdateStatus();
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   IndicatorRelease(HandleRSI);
   IndicatorRelease(HandleMA);
   Comment("");
}

void OnTick()
{
   if(IsTerminated || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return;
   UpdateStatus();
   double bal=AccountInfoDouble(ACCOUNT_BALANCE),eq=AccountInfoDouble(ACCOUNT_EQUITY);
   double locked=bal-InitialBalance;
   if(locked<0) locked=0;
   AdaptiveEquityBase=InitialBalance+locked;
   if(bal>HighWaterMark) HighWaterMark=bal;
   double dd=(eq<AdaptiveEquityBase && AdaptiveEquityBase>0)?(AdaptiveEquityBase-eq)/AdaptiveEquityBase*100.0:0;
   if(dd>=MaxEquityLossPercent)
   {
      DeleteRecoveryPendings();
      CloseAllOrders();
      IsTerminated=true;
      return;
   }

   // Recovery 2 is evaluated before the normal basket exit.
   ManageRecovery2();
   ManageCombinedBasketExit();
   UpdateStatus();

   if(BuyOrders==0 && SellOrders==0 && !Recovery1Active && !Recovery2Active)
   {
      DeleteRecoveryPendings();
      BasketPeakProfit=0;
   }

   ManageRecoveryPending();

   if(!IsTradingHour())
   {
      DisplayDashboard(dd);
      return;
   }

   // Do not add primary positions while either recovery leg is active/pending.
   if(!Recovery1Active && !Recovery2Active && !HasRecoveryPending())
   {
      if(BuyOrders>0 && BuyOrders<MaxOrders)
      {
         double gap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1);
         if(SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)<=PriceOpenLastBuy-gap*_Point)
            ExecutePrimary(ORDER_TYPE_BUY);
      }
      UpdateStatus();
      if(!Recovery1Active && !Recovery2Active && !HasRecoveryPending() && SellOrders>0 && SellOrders<MaxOrders)
      {
         double gap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1);
         if(SymbolInfoDouble(SymbolTrade,SYMBOL_BID)>=PriceOpenLastSell+gap*_Point)
            ExecutePrimary(ORDER_TYPE_SELL);
      }
   }

   UpdateStatus();

   // New primary cycle.
   if(BuyOrders==0 && SellOrders==0 && !Recovery1Active && !Recovery2Active && !HasRecoveryPending())
   {
      double r=GetRSI(),m=GetMA(),p=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
      bool b=false,s=false;
      int lo=RSILower,hi=RSIUpper;
      if(bal<HighWaterMark){lo-=5;hi+=5;}
      if(TypeOrdersPlace!=Open__Only_Sell && p>m && r<lo) b=true;
      if(TypeOrdersPlace!=Open__Only_Buy && p<m && r>hi) s=true;
      if(b) ExecutePrimary(ORDER_TYPE_BUY);
      else if(s) ExecutePrimary(ORDER_TYPE_SELL);
   }

   UpdateStatus();
   ManageRecoveryPending();
   ManageRecovery2();
   DisplayDashboard(dd);
}

void UpdateStatus()
{
   BuyOrders=SellOrders=0;
   BuyProfits=SellProfits=BuyLots=SellLots=0;
   PriceOpenLastBuy=PriceOpenLastSell=0;
   Buy1Price=Sell1Price=Buy3Price=Sell3Price=0;
   Recovery1Profit=Recovery1Lots=0;
   Recovery2Profit=Recovery2Lots=0;
   Recovery1Active=Recovery2Active=false;
   datetime lb=0,ls=0,b1=0,s1=0;

   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong t=PositionGetTicket(i);
      if(!IsOurPosition(t)) continue;
      ENUM_POSITION_TYPE ty=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      double v=PositionGetDouble(POSITION_VOLUME);
      datetime ot=(datetime)PositionGetInteger(POSITION_TIME);
      string c=PositionGetString(POSITION_COMMENT);
      bool r2=StringFind(c,"RECOVERY 2")>=0;
      bool r1=StringFind(c,"RECOVERY SELL STOP")>=0 || StringFind(c,"RECOVERY BUY STOP")>=0 || StringFind(c,"RECOVERY 1")>=0;

      if(r2){Recovery2Active=true;Recovery2Profit+=p;Recovery2Lots+=v;continue;}
      if(r1){Recovery1Active=true;Recovery1Profit+=p;Recovery1Lots+=v;continue;}

      if(ty==POSITION_TYPE_BUY)
      {
         BuyOrders++;BuyProfits+=p;BuyLots+=v;
         if(ot>=lb){lb=ot;PriceOpenLastBuy=PositionGetDouble(POSITION_PRICE_OPEN);}
         if(ot<=b1 || b1==0){b1=ot;Buy1Price=PositionGetDouble(POSITION_PRICE_OPEN);}
         if(StringFind(c,"PRIMARY BUY 3")>=0) Buy3Price=PositionGetDouble(POSITION_PRICE_OPEN);
      }
      else
      {
         SellOrders++;SellProfits+=p;SellLots+=v;
         if(ot>=ls){ls=ot;PriceOpenLastSell=PositionGetDouble(POSITION_PRICE_OPEN);}
         if(ot<=s1 || s1==0){s1=ot;Sell1Price=PositionGetDouble(POSITION_PRICE_OPEN);}
         if(StringFind(c,"PRIMARY SELL 3")>=0) Sell3Price=PositionGetDouble(POSITION_PRICE_OPEN);
      }
   }
}

bool HasRecoveryPending()
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong t=OrderGetTicket(i);
      if(!IsOurOrder(t)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY SELL STOP")>=0 || StringFind(c,"RECOVERY BUY STOP")>=0 || StringFind(c,"RECOVERY 1")>=0) return true;
   }
   return false;
}

void DeleteRecoveryPendings()
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong t=OrderGetTicket(i);
      if(!IsOurOrder(t)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY SELL STOP")<0 && StringFind(c,"RECOVERY BUY STOP")<0 && StringFind(c,"RECOVERY 1")<0) continue;
      trade.OrderDelete(t);
   }
}

void ManageRecoveryPending()
{
   UpdateStatus();
   if(Recovery1Active || Recovery2Active || !EnableRecoveryPending || !IsTradingHour()) return;
   ENUM_POSITION_TYPE primary=WRONG_VALUE;
   double pl=0,lots=0;
   if(BuyOrders>=RecoveryTriggerOrders && SellOrders==0){primary=POSITION_TYPE_BUY;pl=BuyProfits;lots=BuyLots;}
   else if(SellOrders>=RecoveryTriggerOrders && BuyOrders==0){primary=POSITION_TYPE_SELL;pl=SellProfits;lots=SellLots;}
   else return;
   if(pl>=0 || HasRecoveryPending()) return;
   PlaceRecoveryPending(primary,lots);
}

bool PlaceRecoveryPending(ENUM_POSITION_TYPE primary,double primaryLots)
{
   double vol=NormalizeVolume(primaryLots*RecoveryMultiplier);
   if(MaxRecoveryLot>0 && vol>MaxRecoveryLot) vol=NormalizeVolume(MaxRecoveryLot);
   if(vol<=0) return false;
   double gap=(RecoveryGapPoints>0?RecoveryGapPoints:PointsForFirstGap)*_Point;
   int d=(int)SymbolInfoInteger(SymbolTrade,SYMBOL_DIGITS);
   ENUM_ORDER_TYPE ot;double price;string c;
   if(primary==POSITION_TYPE_BUY){ot=ORDER_TYPE_SELL_STOP;price=NormalizeDouble(SymbolInfoDouble(SymbolTrade,SYMBOL_BID)-gap,d);c="GRID 06 V09 RECOVERY SELL STOP";}
   else{ot=ORDER_TYPE_BUY_STOP;price=NormalizeDouble(SymbolInfoDouble(SymbolTrade,SYMBOL_ASK)+gap,d);c="GRID 06 V09 RECOVERY BUY STOP";}
   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);
   bool ok=(ot==ORDER_TYPE_SELL_STOP)?trade.SellStop(vol,price,SymbolTrade,0,0,ORDER_TIME_GTC,0,c):trade.BuyStop(vol,price,SymbolTrade,0,0,ORDER_TIME_GTC,0,c);
   return ok && TradeOK();
}

ulong FindRecovery1Ticket()
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong t=PositionGetTicket(i);
      if(!IsOurPosition(t)) continue;
      string c=PositionGetString(POSITION_COMMENT);
      if(StringFind(c,"RECOVERY SELL STOP")>=0 || StringFind(c,"RECOVERY BUY STOP")>=0 || StringFind(c,"RECOVERY 1")>=0) return t;
   }
   return 0;
}

double CalculateRecovery2Lot()
{
   double vol=Recovery2Lot;
   vol=MathMax(Recovery2MinLot,vol);
   vol=MathMin(Recovery2MaxLot,vol);
   return NormalizeVolume(vol);
}

// Recovery 2 is a reversal handoff, not a second hedge.
// Sequence: Recovery 1 loses -> price confirms reversal -> close Recovery 1 -> open 0.03 Recovery 2.
void ManageRecovery2()
{
   if(!EnableRecovery2 || !IsTradingHour()) return;
   UpdateStatus();
   if(!Recovery1Active || Recovery2Active) return;

   ENUM_POSITION_TYPE primary=WRONG_VALUE;
   if(BuyOrders>=RecoveryTriggerOrders && SellOrders==0) primary=POSITION_TYPE_BUY;
   else if(SellOrders>=RecoveryTriggerOrders && BuyOrders==0) primary=POSITION_TYPE_SELL;
   else return;

   double trigger=0,px=0;
   if(primary==POSITION_TYPE_BUY)
   {
      if(Buy3Price<=0) return;
      trigger=Buy3Price+Recovery2ConfirmPoints*_Point;
      px=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);
      if(px<trigger) return;
   }
   else
   {
      if(Sell3Price<=0) return;
      trigger=Sell3Price-Recovery2ConfirmPoints*_Point;
      px=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
      if(px>trigger) return;
   }

   double basket=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;
   if(Recovery2OnlyIfBasketNegative && basket>=0) return;
   if(Recovery1Profit>=0) return;

   double vol=CalculateRecovery2Lot();
   if(vol<=0) return;

   ulong r1=FindRecovery1Ticket();
   if(r1==0) return;

   // CRITICAL: close Recovery 1 before opening Recovery 2.
   if(!trade.PositionClose(r1) || !TradeOK())
   {
      PrintFormat("V09 Recovery2 handoff: failed to close Recovery1 ticket %I64u retcode=%u",r1,trade.ResultRetcode());
      return;
   }

   UpdateStatus();
   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=(primary==POSITION_TYPE_BUY)?trade.Buy(vol,SymbolTrade,0,0,0,"GRID 06 V09 RECOVERY 2 BUY"):trade.Sell(vol,SymbolTrade,0,0,0,"GRID 06 V09 RECOVERY 2 SELL");
   if(ok && TradeOK())
      PrintFormat("V09 Recovery2 HANDOFF: primary=%s lot=%.2f trigger=%.3f",primary==POSITION_TYPE_BUY?"BUY":"SELL",vol,trigger);
   else
      PrintFormat("V09 Recovery2 handoff: open failed retcode=%u",trade.ResultRetcode());
}

bool ExecutePrimary(ENUM_ORDER_TYPE type)
{
   int c=(type==ORDER_TYPE_BUY)?BuyOrders:SellOrders;
   if(c>=MaxOrders) return false;
   double v=NormalizeVolume(ManualLotSize*(c+1));
   if(v<=0) return false;
   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);
   string cmt=(type==ORDER_TYPE_BUY)?StringFormat("GRID 06 V09 PRIMARY BUY %d",c+1):StringFormat("GRID 06 V09 PRIMARY SELL %d",c+1);
   bool ok=(type==ORDER_TYPE_BUY)?trade.Buy(v,SymbolTrade,0,0,0,cmt):trade.Sell(v,SymbolTrade,0,0,0,cmt);
   return ok && TradeOK();
}

void ManageCombinedBasketExit()
{
   UpdateStatus();
   double p=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;
   if(BuyOrders+SellOrders==0 && !Recovery1Active && !Recovery2Active){BasketPeakProfit=0;return;}
   if(p>=TargetProfitUSD){DeleteRecoveryPendings();CloseAllOrders();BasketPeakProfit=0;return;}
   if(UseTrailingProfit && p>=TrailingStartUSD)
   {
      if(p>BasketPeakProfit) BasketPeakProfit=p;
      if(BasketPeakProfit>0 && p<=BasketPeakProfit-TrailingStopUSD){DeleteRecoveryPendings();CloseAllOrders();BasketPeakProfit=0;}
   }
}

void CloseAllOrders()
{
   for(int i=PositionsTotal()-1;i>=0;i--){ulong t=PositionGetTicket(i);if(!IsOurPosition(t))continue;trade.PositionClose(t);}
}

double GetRSI(){double b[];ArraySetAsSeries(b,true);return CopyBuffer(HandleRSI,0,0,1,b)>0?b[0]:50.0;}
double GetMA(){double b[];ArraySetAsSeries(b,true);return CopyBuffer(HandleMA,0,0,1,b)>0?b[0]:0.0;}

void DisplayDashboard(double dd)
{
   double p=BuyProfits+SellProfits+Recovery1Profit+Recovery2Profit;
   string st=Recovery2Active?"RECOVERY 2 HANDOFF ACTIVE":(Recovery1Active?"RECOVERY 1 ACTIVE":(HasRecoveryPending()?"RECOVERY 1 PENDING":((BuyOrders+SellOrders)>0?"PRIMARY BASKET":"IDLE")));
   Comment("===== GRID 06 V09 =====\nState: ",st,"\nDD: ",DoubleToString(dd,2),"%\nBasket P/L: ",DoubleToString(p,2),"\nPRIMARY BUY: ",BuyOrders," / ",DoubleToString(BuyLots,2)," / ",DoubleToString(BuyProfits,2),"\nPRIMARY SELL: ",SellOrders," / ",DoubleToString(SellLots,2)," / ",DoubleToString(SellProfits,2),"\nRECOVERY 1: ",Recovery1Active?"ACTIVE":"OFF"," / ",DoubleToString(Recovery1Lots,2)," / ",DoubleToString(Recovery1Profit,2),"\nRECOVERY 2: ",Recovery2Active?"ACTIVE":"OFF"," / ",DoubleToString(Recovery2Lots,2)," / ",DoubleToString(Recovery2Profit,2),"\nR2 CONFIRM: ",DoubleToString(Recovery2ConfirmPoints,0)," points | LOT: ",DoubleToString(Recovery2Lot,2),"\nTarget: ",DoubleToString(TargetProfitUSD,2)," | Trail: ",DoubleToString(TrailingStartUSD,2),"/",DoubleToString(TrailingStopUSD,2));
}
