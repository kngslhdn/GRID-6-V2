void DisplayDashboard(double dd, double rsi, bool recovery)
{
   string mode = recovery ? "RECOVERY MODE (Aggressive)" : "NORMAL GROWTH";

   ulong latestBuyId = 0, latestSellId = 0;
   int latestBuyCount = 0, latestSellCount = 0;
   double latestBuyProfit = 0, latestSellProfit = 0;
   double latestBuyPrice = 0, latestSellPrice = 0;

   GetLatestBasket(1, latestBuyId, latestBuyCount, latestBuyProfit, latestBuyPrice);
   GetLatestBasket(-1, latestSellId, latestSellCount, latestSellProfit, latestSellPrice);

   Comment(
      "======== GRID 06 V03 BASKET HEDGE ========\n",
      "Status   : ", (IsTerminated ? "TERMINATED" : "RUNNING"), "\n",
      "Mode     : ", mode, "\n",
      "Drawdown : ", DoubleToString(dd, 2), "%\n",
      "Adaptive Base : ", DoubleToString(AdaptiveEquityBase, 2), "\n",
      "Locked Profit : ", DoubleToString(LockedProfit, 2), "\n",
      "RSI (14) : ", DoubleToString(rsi, 2), "\n",
      "----------------------------------\n",
      "BUY Total: ", BuyOrders,
      " | Basket: #", (string)latestBuyId,
      " | Layers: ", latestBuyCount,
      " | Profit: ", DoubleToString(BuyProfits, 2), "\n",
      "SELL Total: ", SellOrders,
      " | Basket: #", (string)latestSellId,
      " | Layers: ", latestSellCount,
      " | Profit: ", DoubleToString(SellProfits, 2), "\n",
      "Baskets BUY/SELL: ", CountBaskets(1), "/", CountBaskets(-1), "\n",
      "Hedge Engine: ", (UseBasketHedge ? "ON" : "OFF"),
      " | Trigger: ", BasketTriggerOrders, " layers\n",
      "=================================="
   );
}
