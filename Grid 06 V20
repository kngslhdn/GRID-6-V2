//+------------------------------------------------------------------+
//| FUNCTION: OnInit                                                 |
//+------------------------------------------------------------------+
int OnInit()
{
   SymbolTrade=_Symbol;
   OrdersID=(MagicNumber==0)?101010:MagicNumber;
   InitialBalance=AccountInfoDouble(ACCOUNT_BALANCE);
   HighWaterMark=InitialBalance;

   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE);
   HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   if(HandleRSI==INVALID_HANDLE || HandleMA==INVALID_HANDLE)
      return INIT_FAILED;

   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
      return INIT_FAILED;

   ResetDailyTargetIfNewDay();
   UpdateStatus();

   if(IsNewsEngineAllowed())
   {
      EventSetTimer(MathMax(1,NewsRefreshSeconds));
      UpdateNewsStatus();
   }

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| FUNCTION: OnDeinit                                               |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(IsNewsEngineAllowed())
      EventKillTimer();

   IndicatorRelease(HandleRSI);
   IndicatorRelease(HandleMA);
   Comment("");
}

//+------------------------------------------------------------------+
//| FUNCTION: OnTimer                                                |
//+------------------------------------------------------------------+
void OnTimer()
{
   UpdateNewsStatus();
}

//+------------------------------------------------------------------+
//| FUNCTION: OnTick                                                 |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return;

   // A drawdown lock must continue attempting to flatten exposure.  A close
   // can fail transiently (requotes, market closure, or partial execution).
   if(IsTerminated)
   {
      DeleteRecoveryPending();
      CloseAllExposure();
      UpdateStatus();

      double haltedBalance=AccountInfoDouble(ACCOUNT_BALANCE);
      double haltedEquity=AccountInfoDouble(ACCOUNT_EQUITY);
      double haltedDD=(haltedEquity<haltedBalance && haltedBalance>0)?
                      (haltedBalance-haltedEquity)/haltedBalance*100.0:0.0;
      DisplayDashboard(haltedDD);
      return;
   }

   // New WIB calendar day automatically clears the daily lock.
   ResetDailyTargetIfNewDay();

   if(IsNewsEngineAllowed())
      UpdateNewsStatus();

   UpdateStatus();

   double balance=AccountInfoDouble(ACCOUNT_BALANCE);
   double equity=AccountInfoDouble(ACCOUNT_EQUITY);

   if(balance>HighWaterMark)
      HighWaterMark=balance;

   double dd=(equity<balance && balance>0)?
             (balance-equity)/balance*100.0:0.0;

   // Maximum equity drawdown has absolute priority.
   if(dd>=MaxEquityLossPercent)
   {
      DeleteRecoveryPending();
      CloseBasket();
      IsTerminated=true;
      DisplayDashboard(dd);
      return;
   }

   // Daily target has priority over every entry engine.
   if(CheckDailyTarget())
   {
      DisplayDashboard(dd);
      return;
   }

   // Basket target/trailing remains active before grid/recovery logic.
   ManageBasketExit();
   UpdateStatus();

   // Re-check daily target after basket close.
   if(CheckDailyTarget())
   {
      DisplayDashboard(dd);
      return;
   }

   // Outside configured WIB hours, all exposure is closed.
   if(UseTradingHour && !IsTradingHour())
   {
      CloseAllExposure();
      DisplayDashboard(dd);
      return;
   }

   // Optional hard protection during the pre-news close window.
   if(IsNewsEngineAllowed() && NewsCloseWindow)
   {
      DeleteRecoveryPending();
      CloseAllExposure();
      DisplayDashboard(dd);
      return;
   }

   // Recovery is isolated from the primary grid.
   if(RecoveryActive)
   {
      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage2();

      DisplayDashboard(dd);
      return;
   }

   // Flexible recovery trigger: MaxOrders, not hard-coded order #3.
   if(BuyOrders>=MaxOrders && SellOrders==0)
   {
      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage1(POSITION_TYPE_BUY);

      DisplayDashboard(dd);
      return;
   }

   if(SellOrders>=MaxOrders && BuyOrders==0)
   {
      if(!IsNewsBlockingRecovery())
         ManageRecoveryStage1(POSITION_TYPE_SELL);

      DisplayDashboard(dd);
      return;
   }

   // News can independently block first entry or grid expansion.
   if(!IsNewsBlockingPrimary())
      ManagePrimaryGrid();

   DisplayDashboard(dd);
}
