   else if(RecoveryStage==1) state="RECOVERY 1 ACTIVE";
   else if(BuyOrders>0) state=(BuyProfit>0?"PRIMARY BUY / PROFIT MODE":"PRIMARY BUY / LOSS MODE");
   else if(SellOrders>0) state=(SellProfit>0?"PRIMARY SELL / PROFIT MODE":"PRIMARY SELL / LOSS MODE");

   double dailyProfit=GetDailyProfit();

   Comment("===== GRID 06 V18 =====\n",
           "State: ",state,"\n",
           "BASKET P/L: ",DoubleToString(BasketProfitValue,2),"\n",
           "DAILY P/L: ",DoubleToString(dailyProfit,2)," / ",DoubleToString(DailyTargetProfitUSD,2)," | Daily Target: ",(EnableDailyTarget?"ON":"OFF"),"\n",
