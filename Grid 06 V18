//+------------------------------------------------------------------+
//| GRID 06.V18 - PROFIT DIRECTION + TWO-STAGE RECOVERY             |
//| V12 base logic preserved; profit-side pyramiding added          |
//| Loss grid and Recovery 1/2 remain independent and unchanged     |
//| Daily target lock added: WIB-day realized+floating P/L          |
//+------------------------------------------------------------------+
#property strict
#property version "18.01"

#include <Trade/Trade.mqh>
CTrade trade;

//================ TIMEZONE =================//
// Strategy clock is WIB (UTC+7).
// Broker/server time is converted explicitly; execution remains broker/server based.
input double ServerUTCOffsetHours   = 0.0;
input double StrategyUTCOffsetHours = 7.0; // WIB = UTC+7

// Return the raw broker/server time.
datetime GetServerTimeRaw()
{
   return TimeCurrent();
}

// Convert broker/server time to strategy time (WIB by default).
datetime GetStrategyTime()
{
   double deltaHours = StrategyUTCOffsetHours - ServerUTCOffsetHours;
   return GetServerTimeRaw() + (datetime)MathRound(deltaHours * 3600.0);
}

// HistorySelect uses broker/server timestamps.
// Convert WIB day boundaries back to server time before selecting history.
bool SelectStrategyHistory(datetime fromDate,datetime toDate)
{
   double deltaHours = StrategyUTCOffsetHours - ServerUTCOffsetHours;
   int deltaSeconds = (int)MathRound(deltaHours * 3600.0);
   return HistorySelect(fromDate-deltaSeconds,toDate-deltaSeconds);
}

