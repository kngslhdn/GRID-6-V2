//+------------------------------------------------------------------+
//| FUNCTION: GetServerDayKey                                        |
//+------------------------------------------------------------------+
int GetServerDayKey(){
   MqlDateTime dt;
   TimeToStruct(GetStrategyTime(),dt);
   return dt.year*1000+dt.day_of_year;
}

//+------------------------------------------------------------------+
//| FUNCTION: ResetDailyTargetIfNewDay                               |
//+------------------------------------------------------------------+
void ResetDailyTargetIfNewDay(){
   MqlDateTime dt;
   TimeToStruct(GetStrategyTime(),dt);
   int key=dt.year*1000+dt.day_of_year;

   if(DailyTargetYear==dt.year && DailyTargetDayOfYear==dt.day_of_year)
      return;

   DailyTargetYear=dt.year;
   DailyTargetDayOfYear=dt.day_of_year;
   DailyStartBalance=AccountInfoDouble(ACCOUNT_BALANCE);
   DailyTargetReached=false;

   PrintFormat("V18 DAILY RESET | WIB=%s | startBalance=%.2f",
               TimeToString(GetStrategyTime(),TIME_DATE|TIME_SECONDS),DailyStartBalance);
}

//+------------------------------------------------------------------+
//| FUNCTION: GetDailyRealizedProfit                                 |
//| Realized P/L since the start of the current WIB strategy day.    |
//+------------------------------------------------------------------+
double GetDailyRealizedProfit(){
   MqlDateTime dt;
   TimeToStruct(GetStrategyTime(),dt);
   dt.hour=0;
   dt.min=0;
   dt.sec=0;
   datetime dayStart=StructToTime(dt);
   datetime now=GetStrategyTime();

   if(!SelectStrategyHistory(dayStart,now))
      return 0.0;

   double result=0.0;
   int deals=HistoryDealsTotal();
   for(int i=0;i<deals;i++){
      ulong ticket=HistoryDealGetTicket(i);
      if(ticket==0) continue;

      if((long)HistoryDealGetInteger(ticket,DEAL_MAGIC)!=OrdersID) continue;
      if(HistoryDealGetString(ticket,DEAL_SYMBOL)!=SymbolTrade) continue;

      long entry=HistoryDealGetInteger(ticket,DEAL_ENTRY);
      if(entry!=DEAL_ENTRY_OUT && entry!=DEAL_ENTRY_OUT_BY && entry!=DEAL_ENTRY_INOUT)
         continue;

      result += HistoryDealGetDouble(ticket,DEAL_PROFIT);
      result += HistoryDealGetDouble(ticket,DEAL_SWAP);
      result += HistoryDealGetDouble(ticket,DEAL_COMMISSION);
      result += HistoryDealGetDouble(ticket,DEAL_FEE);
   }
   return result;
}

//+------------------------------------------------------------------+
//| FUNCTION: GetDailyProfit                                        |
//| Realized current WIB-day P/L + current floating P/L.             |
//+------------------------------------------------------------------+
double GetDailyProfit(){
   if(!EnableDailyTarget) return 0.0;
   return GetDailyRealizedProfit()+BasketProfitValue;
}

//+------------------------------------------------------------------+
//| FUNCTION: LockDailyTarget                                       |
//| Closes exposure and prevents ALL new entries until next WIB day. |
//+------------------------------------------------------------------+
void LockDailyTarget(){
   if(DailyTargetReached) return;

   DailyTargetReached=true;
   DeleteRecoveryPending();
   CloseAllExposure();
   UpdateStatus();

   PrintFormat("V18 DAILY TARGET REACHED | target=%.2f | dailyProfit=%.2f | WIB=%s | trading locked until next WIB day",
               DailyTargetProfitUSD,GetDailyProfit(),
               TimeToString(GetStrategyTime(),TIME_DATE|TIME_SECONDS));
}

//+------------------------------------------------------------------+
//| FUNCTION: CheckDailyTarget                                     |
//| Returns true when the EA must stop all normal trading this tick. |
//+------------------------------------------------------------------+
bool CheckDailyTarget(){
   if(!EnableDailyTarget || DailyTargetProfitUSD<=0.0) return false;

   ResetDailyTargetIfNewDay();
   if(DailyTargetReached) return true;

   double dailyProfit=GetDailyProfit();
   if(dailyProfit>=DailyTargetProfitUSD){
      LockDailyTarget();
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsTradingHour                                         |
//+------------------------------------------------------------------+
bool IsTradingHour(){
   if(!UseTradingHour) return true;
   MqlDateTime dt; TimeToStruct(GetStrategyTime(),dt);
   if(StartHour<EndHour) return dt.hour>=StartHour && dt.hour<EndHour;
   return dt.hour>=StartHour || dt.hour<EndHour;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsOurPosition                                         |
//+------------------------------------------------------------------+
bool IsOurPosition(ulong ticket){
   if(ticket==0 || !PositionSelectByTicket(ticket)) return false;
   return PositionGetInteger(POSITION_MAGIC)==OrdersID && PositionGetString(POSITION_SYMBOL)==SymbolTrade;
}

//+------------------------------------------------------------------+
//| FUNCTION: IsOurOrder                                            |
//+------------------------------------------------------------------+
bool IsOurOrder(ulong ticket){
   if(ticket==0 || !OrderSelect(ticket)) return false;
   return OrderGetInteger(ORDER_MAGIC)==OrdersID && OrderGetString(ORDER_SYMBOL)==SymbolTrade;
}

//+------------------------------------------------------------------+
//| FUNCTION: TradeOK                                               |
//+------------------------------------------------------------------+
bool TradeOK(){
   uint r=trade.ResultRetcode();
   return r==TRADE_RETCODE_DONE || r==TRADE_RETCODE_DONE_PARTIAL || r==TRADE_RETCODE_PLACED;
}

//+------------------------------------------------------------------+
//| FUNCTION: NormalizeVolume                                       |
//+------------------------------------------------------------------+
double NormalizeVolume(double v){
   double mn=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(SymbolTrade,SYMBOL_VOLUME_STEP);
   if(mn<=0) mn=0.01;
   if(st<=0) st=0.01;
   if(mx<=0) mx=v;
   v=MathMax(mn,MathMin(mx,v));
   v=MathRound(v/st)*st;
   v=MathMax(mn,MathMin(mx,v));
   int digits=(st<0.01)?3:2;
   if(st<0.001) digits=4;
   return NormalizeDouble(v,digits);
}

//+------------------------------------------------------------------+
//| FUNCTION: GetRSI                                                |
//+------------------------------------------------------------------+
double GetRSI(){
   double b[]; ArraySetAsSeries(b,true);
   return CopyBuffer(HandleRSI,0,0,1,b)>0 ? b[0] : 50.0;
}

//+------------------------------------------------------------------+
//| FUNCTION: GetMA                                                 |
//+------------------------------------------------------------------+
double GetMA(int shift=0){
   double b[]; ArraySetAsSeries(b,true);
   return CopyBuffer(HandleMA,0,shift,1,b)>0 ? b[0] : 0.0;
}

//+------------------------------------------------------------------+
//| FUNCTION: OnInit                                                |
//+------------------------------------------------------------------+
int OnInit(){
   SymbolTrade=_Symbol;
   OrdersID=(MagicNumber==0)?101010:MagicNumber;
   InitialBalance=AccountInfoDouble(ACCOUNT_BALANCE);
   HighWaterMark=InitialBalance;
   HandleRSI=iRSI(SymbolTrade,PERIOD_CURRENT,RSIPeriod,PRICE_CLOSE);
   HandleMA=iMA(SymbolTrade,PERIOD_CURRENT,MAPeriod,0,MODE_SMA,PRICE_CLOSE);
   trade.SetExpertMagicNumber(OrdersID);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFillingBySymbol(SymbolTrade);
   if(HandleRSI==INVALID_HANDLE || HandleMA==INVALID_HANDLE) return INIT_FAILED;
   if(AccountInfoInteger(ACCOUNT_MARGIN_MODE)!=ACCOUNT_MARGIN_MODE_RETAIL_HEDGING) return INIT_FAILED;
   ResetDailyTargetIfNewDay();
   UpdateStatus();
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| FUNCTION: OnDeinit                                              |
//+------------------------------------------------------------------+
void OnDeinit(const int reason){
   IndicatorRelease(HandleRSI);
   IndicatorRelease(HandleMA);
   DeleteDashboard();
   Comment("");
}

//+------------------------------------------------------------------+
//| FUNCTION: OnTick                                                |
//+------------------------------------------------------------------+
void OnTick(){
   if(IsTerminated || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return;

   // New WIB calendar day automatically clears the daily lock.
   ResetDailyTargetIfNewDay();

   UpdateStatus();
   double balance=AccountInfoDouble(ACCOUNT_BALANCE);
   double equity=AccountInfoDouble(ACCOUNT_EQUITY);
   if(balance>HighWaterMark) HighWaterMark=balance;
   double dd=(equity<balance && balance>0)?(balance-equity)/balance*100.0:0.0;

   if(dd>=MaxEquityLossPercent){
      DeleteRecoveryPending();
      CloseBasket();
      IsTerminated=true;
      return;
   }

   // Daily target has priority over every entry engine.
   if(CheckDailyTarget()){
      DisplayDashboard(dd);
      return;
   }

   // Trailing/target logic remains unchanged in principle and runs first.
   ManageBasketExit();
   UpdateStatus();

   // Re-check after basket exit because a realized close can complete the daily target.
   if(CheckDailyTarget()){
      DisplayDashboard(dd);
      return;
   }

   // HARD SESSION CLOSE: outside StartHour-EndHour WIB no EA exposure.
   if(UseTradingHour && !IsTradingHour()){
      CloseAllExposure();
      DisplayDashboard(dd);
      return;
   }

   // Once recovery is active, primary grid is frozen exactly as V12.
   if(RecoveryActive){
      ManageRecoveryStage2();
      DisplayDashboard(dd);
      return;
   }

   if(BuyOrders>=MaxOrders && SellOrders==0){
      ManageRecoveryStage1(POSITION_TYPE_BUY);
      DisplayDashboard(dd);
      return;
   }

   if(SellOrders>=MaxOrders && BuyOrders==0){
      ManageRecoveryStage1(POSITION_TYPE_SELL);
      DisplayDashboard(dd);
      return;
   }

   ManagePrimaryGrid();
   DisplayDashboard(dd);
}

//+------------------------------------------------------------------+
//| FUNCTION: UpdateStatus                                          |
//+------------------------------------------------------------------+
void UpdateStatus(){
   BuyOrders=SellOrders=0;
   BuyLots=SellLots=0;
   BuyProfit=SellProfit=0;
   LastBuyPrice=LastSellPrice=0;
   Buy3Price=Sell3Price=0;
   LastBuyTime=LastSellTime=0;

   RecoveryStage=0;
   Recovery1Lots=Recovery1Profit=Recovery1EntryPrice=0;
   Recovery2Lots=Recovery2Profit=Recovery2EntryPrice=0;
   Recovery1Type=WRONG_VALUE;
   Recovery2Type=WRONG_VALUE;

   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i);
      if(!IsOurPosition(ticket)) continue;

      ENUM_POSITION_TYPE type=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double lot=PositionGetDouble(POSITION_VOLUME);
      double p=PositionGetDouble(POSITION_PROFIT)+PositionGetDouble(POSITION_SWAP);
      double open=PositionGetDouble(POSITION_PRICE_OPEN);
      datetime tm=(datetime)PositionGetInteger(POSITION_TIME);
      string c=PositionGetString(POSITION_COMMENT);

      bool recovery1=StringFind(c,"RECOVERY 1 BUY")>=0 || StringFind(c,"RECOVERY 1 SELL")>=0;
      bool recovery2=StringFind(c,"RECOVERY 2 BUY")>=0 || StringFind(c,"RECOVERY 2 SELL")>=0;

      if(recovery1){
         Recovery1Lots+=lot;
         Recovery1Profit+=p;
         Recovery1EntryPrice=open;
         Recovery1Type=type;
         RecoveryStage=MathMax(RecoveryStage,1);
         continue;
      }

      if(recovery2){
         Recovery2Lots+=lot;
         Recovery2Profit+=p;
         Recovery2EntryPrice=open;
         Recovery2Type=type;
         RecoveryStage=MathMax(RecoveryStage,2);
         continue;
      }

      if(type==POSITION_TYPE_BUY){
         BuyOrders++;
         BuyLots+=lot;
         BuyProfit+=p;
         if(tm>=LastBuyTime){
            LastBuyTime=tm;
            LastBuyPrice=open;
         }
         if(StringFind(c,"PRIMARY BUY 3")>=0) Buy3Price=open;
      }
      else if(type==POSITION_TYPE_SELL){
         SellOrders++;
         SellLots+=lot;
         SellProfit+=p;
         if(tm>=LastSellTime){
            LastSellTime=tm;
            LastSellPrice=open;
         }
         if(StringFind(c,"PRIMARY SELL 3")>=0) Sell3Price=open;
      }
   }

   RecoveryLots=Recovery1Lots+Recovery2Lots;
   RecoveryProfit=Recovery1Profit+Recovery2Profit;
   RecoveryActive=(RecoveryStage>0);
   BasketProfitValue=BuyProfit+SellProfit+RecoveryProfit;
}

//+------------------------------------------------------------------+
//| FUNCTION: HasRecoveryPending                                    |
//+------------------------------------------------------------------+
bool HasRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i);
      if(!IsOurOrder(ticket)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY 1 BUY")>=0 || StringFind(c,"RECOVERY 1 SELL")>=0 ||
         StringFind(c,"RECOVERY 2 BUY")>=0 || StringFind(c,"RECOVERY 2 SELL")>=0)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| FUNCTION: DeleteRecoveryPending                                 |
//+------------------------------------------------------------------+
void DeleteRecoveryPending(){
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i);
      if(!IsOurOrder(ticket)) continue;
      string c=OrderGetString(ORDER_COMMENT);
      if(StringFind(c,"RECOVERY 1 BUY")<0 && StringFind(c,"RECOVERY 1 SELL")<0 &&
         StringFind(c,"RECOVERY 2 BUY")<0 && StringFind(c,"RECOVERY 2 SELL")<0)
         continue;
      trade.OrderDelete(ticket);
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageRecoveryStage1                                  |
//| V12 logic preserved: only when primary is minus and 3 orders.   |
//+------------------------------------------------------------------+
void ManageRecoveryStage1(ENUM_POSITION_TYPE primaryType){
   if(!EnableRecovery || RecoveryStage>0 || HasRecoveryPending()) return;
   if(MaxRecoveryStages<1) return;

   double primaryPL=(primaryType==POSITION_TYPE_BUY)?BuyProfit:SellProfit;
   double primaryLots=(primaryType==POSITION_TYPE_BUY)?BuyLots:SellLots;
   double thirdPrice=(primaryType==POSITION_TYPE_BUY)?Buy3Price:Sell3Price;

   if(RecoveryOnlyWhenMinus && primaryPL>=0.0) return;
   if(primaryLots<=0 || thirdPrice<=0) return;

   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);
   if(point<=0) return;

   double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);
   double adversePoints=(primaryType==POSITION_TYPE_BUY)?
                        (thirdPrice-bid)/point:
                        (ask-thirdPrice)/point;
   if(adversePoints<Recovery1GapPoints) return;

   UpdateStatus();
   double basketBefore=BasketProfitValue;
   if(RecoveryOnlyWhenMinus && basketBefore>=0.0) return;

   double lot=NormalizeVolume(primaryLots*Recovery1Multiplier);
   if(Recovery1MaxLot>0.0) lot=NormalizeVolume(MathMin(lot,Recovery1MaxLot));
   if(lot<=0) return;

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=false;
   string c;
   if(primaryType==POSITION_TYPE_BUY){
      c=CommentsOrders+" RECOVERY 1 SELL";
      ok=trade.Sell(lot,SymbolTrade,0,0,0,c);
   }
   else{
      c=CommentsOrders+" RECOVERY 1 BUY";
      ok=trade.Buy(lot,SymbolTrade,0,0,0,c);
   }

   if(ok && TradeOK())
      PrintFormat("V18 R1 OPEN | primary=%s | basket=%.2f | primaryLots=%.2f | R1Lot=%.2f | adverse=%.0f",
                  primaryType==POSITION_TYPE_BUY?"BUY":"SELL",basketBefore,primaryLots,lot,adversePoints);
   else
      PrintFormat("V18 R1 FAILED | basket=%.2f | lot=%.2f | retcode=%u | %s",
                  basketBefore,lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageRecoveryStage2                                  |
//| V12 logic preserved: only while Recovery 1 is minus.             |
//+------------------------------------------------------------------+
void ManageRecoveryStage2(){
   if(!EnableRecovery || RecoveryStage!=1 || MaxRecoveryStages<2) return;
   if(Recovery1Lots<=0 || Recovery1EntryPrice<=0) return;
   if(Recovery1Profit>=0.0) return;
   if(RecoveryOnlyWhenMinus && BasketProfitValue>=0.0) return;

   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);
   if(point<=0) return;

   double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
   double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);
   double adversePoints=0;

   if(Recovery1Type==POSITION_TYPE_BUY)
      adversePoints=(Recovery1EntryPrice-bid)/point;
   else if(Recovery1Type==POSITION_TYPE_SELL)
      adversePoints=(ask-Recovery1EntryPrice)/point;
   else
      return;

   if(adversePoints<Recovery2GapPoints) return;

   double baseLots=BuyLots+SellLots;
   if(baseLots<=0) return;

   double lot=NormalizeVolume(baseLots*Recovery2Multiplier);
   if(Recovery2MaxLot>0.0) lot=NormalizeVolume(MathMin(lot,Recovery2MaxLot));
   if(lot<=0) return;

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=false;
   string c;
   if(Recovery1Type==POSITION_TYPE_BUY){
      c=CommentsOrders+" RECOVERY 2 SELL";
      ok=trade.Sell(lot,SymbolTrade,0,0,0,c);
   }
   else{
      c=CommentsOrders+" RECOVERY 2 BUY";
      ok=trade.Buy(lot,SymbolTrade,0,0,0,c);
   }

   if(ok && TradeOK())
      PrintFormat("V18 R2 OPEN | basket=%.2f | R1PL=%.2f | R2Lot=%.2f | adverse=%.0f",
                  BasketProfitValue,Recovery1Profit,lot,adversePoints);
   else
      PrintFormat("V18 R2 FAILED | basket=%.2f | lot=%.2f | retcode=%u | %s",
                  BasketProfitValue,lot,trade.ResultRetcode(),trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
//| FUNCTION: ManagePrimaryGrid                                     |
//| V18 dual-direction primary grid:                                |
//| 1) PROFIT + SEARAH  -> PointsForProfitGap                        |
//| 2) LOSS   + MELAWAN -> V12 PointsForFirstGap/GAPMultiplier      |
//| Profit path is disabled when the primary basket is not positive. |
//+------------------------------------------------------------------+
void ManagePrimaryGrid(){
   UpdateStatus();
   if(BuyOrders>0 && SellOrders>0) return;

   double point=SymbolInfoDouble(SymbolTrade,SYMBOL_POINT);
   if(point<=0) return;

   //================ BUY PRIMARY =================//
   if(BuyOrders>0 && BuyOrders<MaxOrders){
      double ask=SymbolInfoDouble(SymbolTrade,SYMBOL_ASK);
      double profitGap=PointsForProfitGap*point;
      double lossGap=PointsForFirstGap*MathPow(GapMultiplier,BuyOrders-1)*point;

      // PROFIT DIRECTION: basket/side must be positive and price moves up.
      if(EnableProfitDirection && BuyProfit>0.0){
         if(ask>=LastBuyPrice+profitGap){
            ExecutePrimary(ORDER_TYPE_BUY);
            return;
         }
         // Do not average on an adverse move while the primary side is still positive.
         return;
      }

      // LOSS DIRECTION: original V12 adverse grid.
      if(BuyProfit<=0.0 && ask<=LastBuyPrice-lossGap){
         ExecutePrimary(ORDER_TYPE_BUY);
         return;
      }
      return;
   }

   //================ SELL PRIMARY =================//
   if(SellOrders>0 && SellOrders<MaxOrders){
      double bid=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);
      double profitGap=PointsForProfitGap*point;
      double lossGap=PointsForFirstGap*MathPow(GapMultiplier,SellOrders-1)*point;

      // PROFIT DIRECTION: basket/side must be positive and price moves down.
      if(EnableProfitDirection && SellProfit>0.0){
         if(bid<=LastSellPrice-profitGap){
            ExecutePrimary(ORDER_TYPE_SELL);
            return;
         }
         // Do not average on an adverse move while the primary side is still positive.
         return;
      }

      // LOSS DIRECTION: original V12 adverse grid.
      if(SellProfit<=0.0 && bid>=LastSellPrice+lossGap){
         ExecutePrimary(ORDER_TYPE_SELL);
         return;
      }
      return;
   }

   //================ FIRST ORDER =================//
   if(BuyOrders==0 && SellOrders==0){
      double r=GetRSI();
      double ma=GetMA(0);
      double price=SymbolInfoDouble(SymbolTrade,SYMBOL_BID);

      if(TypeOrdersPlace!=Open__Only_Sell && ma>0 && price>ma && r<RSILower){
         ExecutePrimary(ORDER_TYPE_BUY);
         return;
      }

      if(TypeOrdersPlace!=Open__Only_Buy && ma>0 && price<ma && r>RSIUpper){
         ExecutePrimary(ORDER_TYPE_SELL);
         return;
      }
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: ExecutePrimary                                        |
//+------------------------------------------------------------------+
bool ExecutePrimary(ENUM_ORDER_TYPE type){
   int count=(type==ORDER_TYPE_BUY)?BuyOrders:SellOrders;
   if(count>=MaxOrders) return false;

   double lot=NormalizeVolume(ManualLotSize*(count+1));
   string c=(type==ORDER_TYPE_BUY)
            ?StringFormat("%s PRIMARY BUY %d",CommentsOrders,count+1)
            :StringFormat("%s PRIMARY SELL %d",CommentsOrders,count+1);

   trade.SetExpertMagicNumber(OrdersID);
   trade.SetTypeFillingBySymbol(SymbolTrade);

   bool ok=(type==ORDER_TYPE_BUY)
           ?trade.Buy(lot,SymbolTrade,0,0,0,c)
           :trade.Sell(lot,SymbolTrade,0,0,0,c);

   if(ok && TradeOK()) return true;

   PrintFormat("V18 PRIMARY FAILED retcode=%u | %s",trade.ResultRetcode(),trade.ResultRetcodeDescription());
   return false;
}

//+------------------------------------------------------------------+
//| FUNCTION: ManageBasketExit                                      |
//| Primary + R1 + R2 are one basket. Trailing remains V12-style.    |
//+------------------------------------------------------------------+
void ManageBasketExit(){
   UpdateStatus();
   int total=BuyOrders+SellOrders+
             ((RecoveryStage>0)?1:0)+
             ((RecoveryStage>1)?1:0);

   if(total==0){
      BasketPeakProfit=0;
      BasketTrailingActive=false;
      return;
   }

   double p=BasketProfitValue;
   if(UseTrailingProfit){
      double arm=MathMax(TargetProfitUSD,TrailingStartUSD);
      if(!BasketTrailingActive && p>=arm){
         BasketTrailingActive=true;
         BasketPeakProfit=p;
         PrintFormat("V18 BASKET TARGET REACHED -> TRAILING ON | basket=%.2f | stage=%d",p,RecoveryStage);
      }

      if(BasketTrailingActive){
         if(p>BasketPeakProfit) BasketPeakProfit=p;
         if(p<=BasketPeakProfit-TrailingStopUSD){
            PrintFormat("V18 BASKET TRAILING CLOSE | peak=%.2f | current=%.2f | stage=%d",BasketPeakProfit,p,RecoveryStage);
            DeleteRecoveryPending();
            CloseBasket();
         }
      }
   }
   else if(p>=TargetProfitUSD){
      DeleteRecoveryPending();
      CloseBasket();
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: CloseAllExposure                                      |
//+------------------------------------------------------------------+
void CloseAllExposure(){
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i);
      if(!IsOurOrder(ticket)) continue;
      trade.OrderDelete(ticket);
   }

   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i);
      if(!IsOurPosition(ticket)) continue;
      trade.PositionClose(ticket);
   }

   BasketPeakProfit=0;
   BasketTrailingActive=false;
}

//+------------------------------------------------------------------+
//| FUNCTION: CloseBasket                                           |
//+------------------------------------------------------------------+
void CloseBasket(){
   for(int i=PositionsTotal()-1;i>=0;i--){
      ulong ticket=PositionGetTicket(i);
      if(!IsOurPosition(ticket)) continue;
      trade.PositionClose(ticket);
   }
   BasketPeakProfit=0;
   BasketTrailingActive=false;
}

//+------------------------------------------------------------------+
//| FUNCTION: CreateDashboardLabel                                   |
//+------------------------------------------------------------------+
void CreateDashboardLabel(string name,
                          string text,
                          int x,
                          int y,
                          int fontSize,
                          color textColor)
{
   if(ObjectFind(0,name)<0)
   {
      if(!ObjectCreate(0,name,OBJ_LABEL,0,0,0))
         return;

      ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_ANCHOR,ANCHOR_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,name,OBJPROP_ZORDER,10);
   }

   ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,name,OBJPROP_FONTSIZE,fontSize);
   ObjectSetInteger(0,name,OBJPROP_COLOR,textColor);
   ObjectSetString(0,name,OBJPROP_FONT,"Arial Bold");
   ObjectSetString(0,name,OBJPROP_TEXT,text);
}

//+------------------------------------------------------------------+
//| FUNCTION: CreateDashboardPanel                                   |
//+------------------------------------------------------------------+
void CreateDashboardPanel()
{
   string name=DASH_PREFIX+"BG";

   if(ObjectFind(0,name)<0)
   {
      if(!ObjectCreate(0,name,OBJ_RECTANGLE_LABEL,0,0,0))
         return;

      ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_XDISTANCE,10);
      ObjectSetInteger(0,name,OBJPROP_YDISTANCE,20);
      ObjectSetInteger(0,name,OBJPROP_XSIZE,430);
      ObjectSetInteger(0,name,OBJPROP_YSIZE,445);

      // Orange panel with approximately 50% alpha transparency.
      ObjectSetInteger(0,name,OBJPROP_BGCOLOR,ColorToARGB(clrOrange,128));
      ObjectSetInteger(0,name,OBJPROP_COLOR,clrOrange);
      ObjectSetInteger(0,name,OBJPROP_BORDER_TYPE,BORDER_FLAT);
      ObjectSetInteger(0,name,OBJPROP_WIDTH,2);

      ObjectSetInteger(0,name,OBJPROP_BACK,false);
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,name,OBJPROP_ZORDER,0);
   }
}

//+------------------------------------------------------------------+
//| FUNCTION: DeleteDashboard                                        |
//+------------------------------------------------------------------+
void DeleteDashboard()
{
   for(int i=ObjectsTotal(0,-1,-1)-1;i>=0;i--)
   {
      string name=ObjectName(0,i,-1,-1);

      if(StringFind(name,DASH_PREFIX)==0)
         ObjectDelete(0,name);
   }
}

